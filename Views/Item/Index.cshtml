@using Digital_Services_BD.ViewModels
@model List<ProductItem>
@inject IProductGroupOps productGroupOps
@inject IProductItemOps productItemOps
@inject IProductCategoryOps productCategoryOps

@{
    var locationOrigin = Url.Action("Index", "Item", new { id = ViewBag.Id });
    var allProductGroups = productGroupOps.GetAllProductGroups().ToList();
    var allProductGroupIdsUnderThisCategory = productCategoryOps.GetAllProductGroupIdsByCategoryId(ViewBag.Id);
}
<script type="text/javascript">
    var locationOrigin = "@locationOrigin";
    var priceMin = "@ViewBag.PriceMin";
    var priceMax = "@ViewBag.PriceMax";
    var pageNo = "@ViewBag.PageNO";
    var sortBy = "@ViewBag.SortBy";
</script>

<div class="row mt-8 p-3">
    <ul class="breadcrumb w-100 p-0 m-0 link-normal">
        <li class="breadcrumb-item">
            <a asp-controller="Home" asp-action="Index">
                <i class="fas fa-home mr-1"></i>Home
            </a>
        </li>
        <li class="breadcrumb-item">
            <a href="@Url.Action("Index", "Category", new { id = allProductGroupIdsUnderThisCategory[0]})">
                @(allProductGroups.Where(g => g.Id == allProductGroupIdsUnderThisCategory[0]).Select(g => g.Name).FirstOrDefault())
            </a>
        </li>
        <li class="breadcrumb-item active">
            <a href="@Url.Action("Index", "Item", new { id = ViewBag.Id})">
                @ViewBag.ProductCategoryName
            </a>
        </li>
    </ul>
</div>
<div class="row p-2">
    <div class="col-lg-3 col-md-4 col-sm-12 pl-0">
        <div class="navbar-expand-md">
            <button class="btn btn-light navbar-toggler m-2" data-toggle="collapse" data-target="#filterContent">
                <i class="fas fa-filter"></i>
                <span>Filter</span>
            </button>
            <div class="collapse navbar-collapse" id="filterContent">
                <div id="accordion" class="w-100 link-normal ml-1">
                    <div class="card">
                        <div class="card-header p-0">
                            <button class="btn btn-light w-100 text-left pl-2" data-target="#filter1" data-toggle="collapse">
                                Price Range
                                <i class="float-right fas fa-angle-down text-muted"></i>
                            </button>
                        </div>
                        <div class="collapse show" @*data-parent="#accordion"*@ id="filter1">
                            <div class="card-body">
                                <div id="priceRange"></div>
                                <div id="priceLabel" for="priceRange" class="text-center mt-2">@ViewBag.PriceMin<sup>BDT</sup>&nbsp;&mdash;&nbsp;@ViewBag.PriceMax<sup>BDT</sup></div>
                                <div id="goPrice" class="btn btn-dark">Go</div>
                            </div>
                        </div>
                    </div>

                    <div class="card">
                        <div class="card-header p-0">
                            <button class="btn btn-light w-100 text-left pl-2" data-target="#filter2" data-toggle="collapse">
                                Subcategory
                                <i class="float-right fas fa-angle-down text-muted"></i>
                            </button>
                        </div>
                        <div class="collapse show" @*data-parent="#accordion"*@ id="filter2">
                            <div class="card-body p-0 pl-2 pr-2">
                                <ul class="list-group list-group-flush link-normal">
                                    @foreach (var productCategory in productCategoryOps.GetAllProductCategories())
                                    {
                                        <li class="list-group-item p-0 pt-2">
                                            <a asp-controller="Item" asp-action="Index" asp-route-id="@productCategory.Id">
                                                <span class=" @(productCategory.Id == ViewBag.Id ? "text-muted font-weight-bold": "")"> @productCategory.Name</span>
                                            </a>
                                        </li>
                                    }

                                </ul>
                            </div>
                        </div>
                    </div>

                    <div class="card">
                        <div class="card-header p-0">
                            <button class="btn btn-light w-100 text-left pl-2" data-target="#filter3" data-toggle="collapse">
                                Category
                                <i class="float-right fas fa-angle-down text-muted"></i>
                            </button>
                        </div>
                        <div class="collapse show" @*data-parent="#accordion"*@ id="filter3">
                            <div class="card-body p-0 pl-2 pr-2">
                                <ul class="list-group list-group-flush link-normal">
                                    @foreach (var productGroup in allProductGroups)
                                    {
                                        <li class="list-group-item p-0 pt-2">
                                            <a asp-controller="Category" asp-action="Index" asp-route-id="@productGroup.Id">
                                                <span class=" @(allProductGroupIdsUnderThisCategory.Contains(productGroup.Id) ? "text-muted font-weight-bold": "")"> @productGroup.Name</span>
                                            </a>
                                        </li>
                                    }

                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-9 col-md-8 col-sm-12">
        <h4>@ViewBag.ProductCategoryName<sub class="text-muted ml-2">(@ViewBag.TotalItem item/s)</sub></h4>
        <div class="form-row d-flex justify-content-end">
            <label class="mr-2 pt-1">Sort By</label>
            <select id="sortBy" class="selectpicker">
                <option value="m_p" selected>Most Popular</option>
                <option value="name">Name</option>
                <option value="p_l_h">Price Low &rarr; High</option>
                <option value="p_h_l">Price High &rarr; Low</option>
            </select>
        </div>
        <hr />
        <div class="card-deck row">
            @for (var i = 0; i < Model.Count; i++)
            {
                var priceObj = Model[i].ProductItemPrice.FirstOrDefault();
                <div class="col-lg-4 col-md-6 col-sm-12 p-0 pt-2">
                    <div class="card m-2 link-normal">
                        <a class="text-decoration-none text-black" asp-action="Details" asp-controller="Product">
                            <div class="d-flex justify-content-center align-items-center">
                                <img class="img-fluid h-240" src="\@Model[i].ImageUrl" />
                            </div>
                            <div class="card-body p-1">
                                <h5>@Model[i].Name</h5>

                            </div>
                            <div class="card-footer p-1">
                                <div class="price-font">
                                    <strong>@string.Format("{0:0.00}", priceObj.Price - priceObj.Discount)</strong>
                                    <sup>BDT</sup>
                                </div>
                                @if (priceObj.Discount > 0)
                                {
                                    <div class="text-black">
                                        <s class="text-muted">@priceObj.Price</s>
                                        <sup class="text-muted">BDT</sup>
                                        <span class="ml-1 bg-primary p-1">
                                            <span class="text-white">@string.Format("{0:0.00}", -(priceObj.Discount * 100) / priceObj.Price)%</span>
                                        </span>
                                    </div>
                                }
                            </div>
                        </a>
                    </div>
                </div>
            }
        </div>

        @if (Model.Count > 0)
        {
            <div class="row d-flex justify-content-center">
                <ul class="pagination">
                    @if (ViewBag.PageNo >= 2)
                    {
                        <li class="page-item">
                            <a class="page-link" asp-controller="Item" asp-action="Index" asp-route-id="@ViewBag.Id"
                               asp-route-pageNo="@(ViewBag.PageNo-1)">&laquo;</a>
                        </li>
                    }
                    @if (ViewBag.PageNo < 5)
                    {
                        @for (var i = 1; i <= ViewBag.PageNo; i++)
                        {
                            <li class="page-item @(i == ViewBag.PageNo ? "active": "")">
                                <a class="page-link" asp-controller="Item" asp-action="Index" asp-route-id="@ViewBag.Id"
                                   asp-route-pageNo="@i">@i</a>
                            </li>
                        }
                    }
                    else
                    {
                        <li class="page-item">
                            <a class="page-link" asp-controller="Item" asp-action="Index" asp-route-id="@ViewBag.Id"
                               asp-route-pageNo="1">1</a>
                        </li>
                        <li class="page-item">
                            ...
                        </li>



                        @for (var i = ViewBag.PageNo - 2; i <= ViewBag.PageNo; i++)
                        {
                            <li class="page-item @(i == ViewBag.PageNo ? "active": "")">
                                <a class="page-link" asp-controller="Item" asp-action="Index" asp-route-id="@ViewBag.Id"
                                   asp-route-pageNo="@i">@i</a>
                            </li>
                        }
                    }
                    @*--------  Second Half  -------- *@
                    @if ((ViewBag.TotalItem / ProductConfig.NoOfProductItemPerPage) - ViewBag.PageNo < 5)
                    {
                        @for (var i = ViewBag.PageNo + 1; i <= (ViewBag.TotalItem / ProductConfig.NoOfProductItemPerPage); i++)
                        {
                            <li class="page-item">
                                <a class="page-link" asp-controller="Item" asp-action="Index" asp-route-id="@ViewBag.Id" asp-route-pageNo="@i">@i</a>
                            </li>
                        }
                    }
                    else
                    {
                        @for (var i = ViewBag.PageNo + 1; i <= ViewBag.PageNo + 2; i++)
                        {
                            <li class="page-item">
                                <a class="page-link" asp-controller="Item" asp-action="Index" asp-route-id="@ViewBag.Id" asp-route-pageNo="@i">@i</a>
                            </li>
                        }
                        <li class="page-item">
                            ...
                        </li>
                        <li class="page-item">
                            <a class="page-link" asp-controller="Item" asp-action="Index" asp-route-id="@ViewBag.Id"
                               asp-route-pageNo="@(ViewBag.TotalItem / ProductConfig.NoOfProductItemPerPage)">@(ViewBag.TotalItem / ProductConfig.NoOfProductItemPerPage)</a>
                        </li>
                    }
                    @if ((ViewBag.TotalItem / ProductConfig.NoOfProductItemPerPage) - ViewBag.PageNo >= 1)
                    {
                        <li class="page-item">
                            <a class="page-link" asp-controller="Item" asp-action="Index" asp-route-id="@ViewBag.Id"
                               asp-route-pageNo="@(ViewBag.PageNo+1)">&raquo;</a>
                        </li>
                    }
                </ul>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('[data-toggle="tooltip"]').tooltip();
            //Select change
            $("#sortBy").change(function () {
                window.location.href = locationOrigin + "?sortBy=" + $(this).val() + "&priceRange=" +
                    $("#priceRange").slider("option", "values")[0] + "to" + $("#priceRange").slider("option", "values")[1]
                    + "&pageNo=1";
            });
            //Price slider
            $("#priceRange").slider({
                range: true,
                min: 200,
                max: 5000,
                values: [parseInt(priceMin), parseInt(priceMax)],
                slide: function (event, ui) {
                    $("#priceLabel").html(ui.values[0].toString() + "<sup>BDT</sup>&nbsp;&mdash;&nbsp;" + ui.values[1].toString() + "<sup>BDT</sup>");
                }
            });
            //Price submit
            $("#goPrice").click(function () {
                window.location.href = locationOrigin + "?sortBy=" + $("#sortBy").val() + "&priceRange=" +
                    $("#priceRange").slider("option", "values")[0] + "to" + $("#priceRange").slider("option", "values")[1] +
                    + "&pageNo=" + pageNo;
            });
            $("#priceLabel").html(priceMin + "<sup>BDT</sup>&nbsp;&mdash;&nbsp;" + priceMax + "<sup>BDT</sup>");
            $("#sortBy").val(sortBy);
        });
    </script>
}