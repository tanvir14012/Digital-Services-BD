@model ProductItemBundle

@{
    var price = Model.ProductItemBundleJoinProductItem
        .Sum(join => (join.ProductItem.ProductItemPrice.Where(p => p.PriceCurrency == "BDT").FirstOrDefault()?.Price ?? 0) * join.ProductItemQuantity);

    var discount = Model.ProductItemBundleJoinProductItem
        .Sum(join => (join.ProductItem.ProductItemPrice.Where(p => p.PriceCurrency == "BDT").FirstOrDefault()?.Discount ?? 0) * join.ProductItemQuantity);

    var vat = Model.ProductItemBundleJoinProductItem
        .Sum(join => (join.ProductItem.ProductItemPrice.Where(p => p.PriceCurrency == "BDT").FirstOrDefault()?.Vat ?? 0) * join.ProductItemQuantity);

    var minStock = Model.ProductItemBundleJoinProductItem
        .Min(join => join.ProductItem.ProductStockCount.Count/join.ProductItemQuantity);
}

<div class="spacer"></div>

@if (ViewBag.Message != null)
{
    <div class="row p-3">
        <div class="@ViewBag.AlertClass" role="alert">
            @ViewBag.Message
        </div>
    </div>
}

<div class="row w-100 p-2">
    <!-- Left sidebar (image) -->
    <div class="col-lg-3 col-md-6 col-sm-12">
        <div class="position-absolute right-0 mx-4 my-2 px-2 py-1 badge badge-pill badge-@(minStock > 0 ? "info": "danger")">
            @(minStock > 0 ? "in stock": "out of stock")
        </div>
        <div class="h-240 w-100 d-flex flex-column">
            <div class="position-absolute w-100 h-240 right-0">
                <img class="w-100 scale-half" height="240" src="~/ImageResources/UI/gift-ribbon.png">
            </div>
            @foreach (var join in Model.ProductItemBundleJoinProductItem)
            {
                <img asp-append-version="true" class="obj-fit-contain" height="@(240/Model.ProductItemBundleJoinProductItem.Count)" src="\@join.ProductItem.ImageUrl" />
            }

        </div>
    </div>
    <!-- Left sidebar (image)-->
    <!-- Middle content (description) -->
    <div class="col-lg-6 col-md-6 col-sm-12">
        <h4 class="mt-3">@Model.Name</h4>
        <ul class="list-group list-group-flush">
            @foreach(var join in Model.ProductItemBundleJoinProductItem)
            {
                <li class="list-group-item">
                    <a asp-controller="Detail" asp-action="Index" asp-route-id="@join.ProductItem.Id" class="nav-link">@join.ProductItem.Name <span class="ml-2 badge badge-dark">@join.ProductItemQuantity x</span></a>
                </li>
            }
        </ul>
    </div>
    <!-- Middle content (description)-->
    <!-- Right sidebar (cart) -->
    <div class="col-lg-3 col-md-12 col-sm-12">
        <h4 class="mt-3 d-inline-flex">
            <strong class="mr-2 price-font">Price:</strong>
            <strong class="price-font">@string.Format("{0: 0.00}", price + vat - discount - Model.BundleDiscount)<sup>BDT</sup></strong>
        </h4>
        @if (Model.BundleDiscount > 0)
        {
            <h5 class="mt-2 p-1 d-inline-flex">
                <s class="mr-2">@string.Format("{0: 0.00}", price + vat)</s>
                <span class="border text-danger border-danger font-weight-bold text-nowrap">@string.Format("{0:0.00}", ((discount + Model.BundleDiscount) * 100) / (price + vat))% OFF</span>
            </h5>
        }
        <div class="mt-3 d-sm-flex d-lg-block">
            <div class="d-flex">
                <label for="quantity" class="col-form-label mt-1">Quantity</label>
                <button id="subtractQuantity" name="subtractQuantity" class="btn btn-sm btn-light m-2"><i class="fas fa-minus"></i></button>
                <input id="quantity" type="number" class="form-control-sm m-2" min="1" max="10" value="1" />
                <button id="addQuantity" name="addQuantity" class="btn btn-sm btn-light m-2"><i class="fas fa-plus"></i></button>
            </div>
            <form class="d-inline-block" method="post" asp-action="AddBundleToCart" asp-controller="Cart">
                <button name="addToCart" type="button" class="btn btn-light m-1">
                    <i class="fas fa-cart-plus text-primary mr-2"></i>Add to Cart
                </button>
                @Html.AntiForgeryToken()
                @Html.Hidden("userId", null)
                @Html.Hidden("itemId", Model.Id)
                @Html.Hidden("returnUrl", @Context.Request.Path)
                @Html.Hidden("addToCartQuantity", 1)
            </form>
            <form class="d-inline-block" method="post" asp-action="BuyBundleNow" asp-controller="Cart">
                <button name="buyNow" type="button" class="btn btn-light m-1">
                    <i class="fas fa-shopping-bag text-info mr-2"></i>Buy Now&nbsp;&nbsp;&nbsp;&nbsp;
                </button>
                @Html.AntiForgeryToken()
                @Html.Hidden("userId2", null)
                @Html.Hidden("itemId2", Model.Id)
                @Html.Hidden("buyNowQuantity", 1)
                @Html.Hidden("returnUrl2", @Context.Request.Path)
            </form>
        </div>
    </div>
    <!-- Right sidebar (cart)-->
    <!-- Description -->
</div>


@section Scripts {
    <script>
        $(document).ready(function () {
            //Data dismissal
            $(".alert").alert();

            //Add, subtract qty, disable btn
            $("#addQuantity").click(function () {
                $("#quantity").val(parseInt($("#quantity").val()) + 1);
                $("#quantity").trigger("change");
            });
            $("#subtractQuantity").click(function () {
                $("#quantity").val(parseInt($("#quantity").val()) - 1);
                $("#quantity").trigger("change");
            });
            $("#quantity").change(function () {
                $("#addQuantity").attr('disabled', false);
                $("#subtractQuantity").attr('disabled', false);

                if ($(this).val() <= 1) {
                    $(this).val(1);
                    $("#subtractQuantity").attr('disabled', true);
                }
                else if ($(this).val() >= 10) {
                    $(this).val(10);
                    $("#addQuantity").attr('disabled', true);
                }

            });
            $("button[name='addToCart']").click(function (e) {
                $("#addToCartQuantity").val(parseInt($("#quantity").val()));
                $(e.target).closest("form").submit();
            });
            $("button[name='buyNow']").click(function (e) {
                $("#buyNowQuantity").val(parseInt($("#quantity").val()));
                $(e.target).closest("form").submit();
            });
        });
    </script>
}