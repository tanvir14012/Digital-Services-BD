    <div class="row mt-4 p-2">

        <div class="col-md-6 col-sm-12">
            <h4>@ViewBag.Heading</h4>
            <p>@ViewBag.Message</p>
            <ul class="list-group list-group-horizontal-md link-normal">
                <li class="list-group-item p-0 border-0 btn btn-sm btn-light">
                    <a class="nav-link" asp-action="Index" asp-controller="Home"><i class="fas fa-home mr-2"></i>Home</a>
                </li>
                <li class="list-group-item p-0 border-0 btn btn-sm btn-light">
                    <a class="nav-link" asp-action="@ViewBag.Action" asp-controller="@ViewBag.Controller"><i class="fas fa-backward mr-2"></i>@ViewBag.BackText</a>
                </li>
            </ul>
        </div>
        <div class="col-md-6 col-sm-12 d-flex justify-content-center align-items-start h-240">
            <div class="d-block mt-4">
                <i class="fas fa-search-location mr-2 text-secondary" style="transform: scale(3,3);">Not Found!</i>
            </div>
        </div>
    </div>