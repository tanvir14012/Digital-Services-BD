@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Authorization
@using System.Security.Claims;


@{
    var productGroups = ViewData["LayoutProductGroups"] as ICollection<ProductGroup> ?? Array.Empty<ProductGroup>();
    var cartCount = ViewData["LayoutCartCount"] as int? ?? 0;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - Nilu Digital</title>


    <environment include="Development">
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" />
        <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" rel="stylesheet" />
        <link href="https://code.jquery.com/ui/1.14.2/themes/base/jquery-ui.css" rel="stylesheet" />
    </environment>
    <environment exclude="Development">
        <!-- Bootstrap CSS  -->
        <link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
              asp-fallback-href="~/lib/twitter-bootstrap/css/bootstrap.min.css"
              asp-fallback-test-class="visually-hidden"
              asp-fallback-test-property="position"
              asp-fallback-test-value="absolute"
              asp-suppress-fallback-integrity="true">
        <!-- Fontawesome CSS  -->
        <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.13.0/css/all.min.css"
              rel="stylesheet"
              asp-fallback-href="~/lib/font-awesome/css/all.css">
        <link href="~/lib/bootstrap-select/css/bootstrap-select.min.css" rel="stylesheet" type="text/css" />
        <link href="~/lib/jquery-datetimepicker/jquery.datetimepicker.min.css" rel="stylesheet" type="text/css" />
        <link href="https://cdnjs.cloudflare.com/ajax/libs/jqueryui/1.14.2/jquery-ui.min.css" rel="stylesheet" type="text/css" />

    </environment>
    <link rel="stylesheet" href="~/css/bootstrap4-compat.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/storefront.css" asp-append-version="true" />
</head>
<body>
    <a class="visually-hidden-focusable skip-link" href="#main-content">Skip to content</a>
    <header class="fixed-top z-10">
        <nav class="navbar navbar-light pb-0" id="navbar1">
            <div class="container justify-content-start" id="navbar1_container">
                <a class="navbar-brand" href="/">
                    <img class="" src="~/branding/companyLogo.png" width="100" height="40" />
                </a>
                <form class="d-flex flex-grow-1" method="post" asp-controller="Home" asp-action="Search">
                    @Html.AntiForgeryToken()
                    <div class="input-group w-100">
                        <input type="search" class="form-control" autocomplete="off" name="Term" placeholder="Search" id="searchInput" aria-label="Search products" />
                        <button type="submit" id="searchSubmit" aria-label="Search" disabled class="btn btn-outline-secondary"><i class="fas fa-search"></i></button>
                    </div>
                </form>
                <div class="dropdown">
                    <a class="nav-link dropdown-toggle text-secondary" data-bs-toggle="dropdown" href="#">
                        <i class="fas fa-language"></i>
                    </a>
                    <ul class="dropdown-menu">
                        <li class="dropdown-item">English</li>
                        <li class="dropdown-item">বাংলা</li>
                    </ul>
                </div>
                <a asp-action="Index" asp-controller="Cart" class="nav-link text-secondary">
                    <i class="fas fa-shopping-cart align-bottom"></i><span class="badge text-bg-success rounded-circle align-top">@cartCount</span>
                </a>
            </div>

            <nav class="navbar navbar-expand-sm navbar-light w-100 pt-0 bg-white" id="navbar2">
                <button class="navbar-toggler m-2" data-bs-toggle="collapse" data-bs-target="#navLinks"
                        aria-controls="navLinks" aria-expanded="false" aria-label="toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="container" id="navbar2_container">
                    <ul class="navbar-nav collapse navbar-collapse border-md-bottom ps-2 shadow-sm-bottom" id="navLinks">
                        @foreach (var productGroup in productGroups)
                        {
                            <li class="nav-item me-2 pe-2 pt-2">
                                <a asp-action="Index" asp-controller="Category" asp-route-id="@productGroup.Id"
                                   class="nav-link text-muted ps-0 pe-0" id="1" type="button" data-bs-toggle="dropdown"
                                   aria-haspopup="true" aria-expanded="false">
                                    <span>@productGroup.Name</span>
                                </a>
                                <div class="dropdown-menu w-100 border border-0 pt-0" aria-labelledby="1">
                                    <div class="container ps-2">
                                        <div class="row w-100 border rounded ps-0 ms-1">
                                            @foreach (var productCategory in productGroup.AllCategories)
                                            {
                                                <div class="col-lg-3 col-md-4 col-sm-6 ps-0">
                                                    <a asp-action="Index" asp-controller="Category" asp-route-id="@productGroup.Id"
                                                       class="dropdown-item dropdown-header fw-bold border-bottom overflow-hidden">@productCategory.Name</a>

                                                    @foreach (var productItem in productCategory.AllItems)
                                                    {
                                                        <a class="dropdown-item overflow-hidden text-wrap" asp-action="Index" asp-controller="Detail" asp-route-id="@productItem.Id">@productItem.Name</a>
                                                    }
                                                </div>
                                            }

                                        </div>

                                    </div>
                                </div>
                            </li>
                        }
                    </ul>
                </div>
            </nav>
        </nav>
    </header>

    <div class="container mt-5 pt-5" id="main_container">
        <main id="main-content" role="main" class="pb-3 mt-4">
            @RenderBody()
        </main>
    </div>

    <footer class="footer text-muted mt-5">
        <div class="container border-top">
            <ul class="list-group list-group-horizontal justify-content-center m-2">
                <li class="list-group-item me-2 px-2 py-1 rounded">
                    <a href="#" class="text-primary">
                        <i class="fab fa-facebook"></i>
                    </a>
                </li>
                <li class="list-group-item me-2 px-2 py-1 rounded border-start">
                    <a href="#" class="text-primary">
                        <i class="fab fa-twitter"></i>
                    </a>
                </li>
                <li class="list-group-item me-2 px-2 py-1 rounded border-start">
                    <a href="#" class="text-primary">
                        <i class="fab fa-google"></i>
                    </a>
                </li>
                <li class="list-group-item me-2 px-2 py-1 rounded border-start">
                    <a href="#" class="text-primary">
                        <i class="fab fa-linkedin"></i>
                    </a>
                </li>
            </ul>
            <div class="container text-center">
                &copy;2021 Nilu Digital. All rights reserved. <a asp-area="" asp-controller="Home" asp-action="Privacy">Terms & Conditions and Privacy Policy</a>
            </div>
        </div>
    </footer>
    <script src="https://code.jquery.com/jquery-4.0.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.22.1/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>
    <script src="https://code.jquery.com/ui/1.14.2/jquery-ui.min.js"></script>
    <script type="text/javascript" src="~/js/site.js" asp-append-version="true"></script>
    <script type="text/javascript" src="~/js/Layout.js" asp-append-version="true"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
