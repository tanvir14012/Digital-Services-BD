@using Digital_Services_BD.ViewModels
@model OrderEmailTemplate

@{
    Layout = null;
    if (string.IsNullOrEmpty(Model.RecipeintName) || string.IsNullOrWhiteSpace(Model.RecipeintName))
    {
        Model.RecipeintName = "valued customer";
    }
}
<!DOCTYPE html>
<html>
<head>
    <meta lang="en-us" charset="utf-8" />
    <title>Order delivery</title>
</head>
<body style="width: 100%; background-color: ghostwhite;">
    <table align="center" border="0" cellspacing="0" cellpadding="0" max-width: 600px;">
        <tr>
            <td>
                <table style="border-collapse: collapse; background-color: white; margin-top: 20px; width: 600px;">
                    <thead>
                        <tr style="text-align: left; padding: 8px;">
                            <th style="width: 10%;"></th>
                            <th style="width: 80%;"></th>
                            <th style="width: 10%;"></th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td align="center" colspan="3">
                                <div style="margin: 5px;">
                                    <img src="cid:@(Model.EmailLinkedResources[0].ContentId)" width="144" height="80" />
                                </div>
                            </td>
                        </tr>

                        <tr style="background-color: tomato; color: white;">
                            <td style="width: 10%;"></td>
                            <td style="width: 80%;">
                                <table style="border-collapse: collapse;">
                                    <thead>
                                        <tr style="text-align: left; padding: 8px;">
                                            <th style="width: 30%;"></th>
                                            <th style="width: 10%;"></th>
                                            <th style="width: 60%;"></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr style="text-align: left; padding: 8px;">
                                            <td>
                                                <div>@Model.ShopName</div>
                                            </td>
                                            <td></td>
                                            <td>
                                                <div style="float: right;">
                                                    <div>
                                                        <a style="text-decoration: none; color: white;"
                                                           href='@Model.Website'>@Model.Website</a>
                                                    </div>
                                                </div>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </td>
                            <td style="width: 10%;"></td>
                        </tr>

                        <tr>
                            <td style="width: 10%;"></td>
                            <td style="width: 80%;">
                                <div style="font-size:medium; font-weight: bold; margin-top: 24px; margin-bottom: 24px;">
                                    Dear @Model.RecipeintName,<br />
                                    Good news! Your order has arrived. Thank you for shopping with us!
                                </div>
                            </td>
                            <td style="width: 10%;"></td>
                        </tr>
                    </tbody>
                </table>

                <table style="border-collapse: collapse; background-color: white; width: 600px;">
                    <thead style="background-color:ghostwhite">
                        <tr>
                            <th colspan="4" style="border:1px solid ghostwhite; padding:5px; text-align:center;">Order Delivery</th>
                        </tr>
                    </thead>
                    <thead>
                        <tr>
                            <th colspan="1" style="border:1px solid ghostwhite; padding:5px; text-align:left;">Order #@Model.Order.Id</th>
                            <th colspan="3" style="border:1px solid ghostwhite; padding:5px; text-align:right;">Placed on: @Model.Order.CreatedOn</th>
                        </tr>
                    </thead>
                    <thead style="background-color:ghostwhite;">
                        <tr>
                            <th colspan="2" style="border:1px solid ghostwhite; padding:5px; text-align:left;">Order Item</th>
                            <th colspan="2" style=" border:1px solid ghostwhite; padding:5px; text-align:left;">Deliverable</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Order.Deliverable.DeliverableItems)
                        {

                            <tr>
                                <td colspan="2" style="border:1px solid ghostwhite; padding:5px; text-align:left;">@item.ProductStock.ProductItem.Name</td>
                                <td colspan="2" style="border: 1px solid ghostwhite; padding: 5px; text-align: left;">
                                    <table style="border: none" cellspacing="0" cellpadding="0">
                                        <tr>
                                            <td>
                                                <div style="border: 1px dotted gray; margin: 5px; font-weight: bold; font-size:large">@item.ProductStock.MainCode</div>
                                            </td>
                                        </tr>
                                        @if (item.ProductStock.AuxiliaryCode != null)
                                        {
                                            <tr>
                                                <td>
                                                    <div style="border: 1px dotted gray; margin: 5px; font-weight: bold; font-size:large">@item.ProductStock.AuxiliaryCode</div>
                                                </td>
                                            </tr>
                                        }
                                        @if (item.ProductStock.OptionA != null)
                                        {
                                            <tr>
                                                <td>
                                                    <div style="border: 1px dotted gray; margin: 5px; font-weight: bold; font-size:large">@item.ProductStock.OptionA</div>
                                                </td>
                                            </tr>
                                        }
                                        @if (item.ProductStock.OptionB != null)
                                        {
                                            <tr>
                                                <td>
                                                    <div style="border: 1px dotted gray; margin: 5px; font-weight: bold; font-size:large">@item.ProductStock.OptionB</div>
                                                </td>
                                            </tr>
                                        }
                                        @if (item.ProductStock.OptionC != null)
                                        {
                                            <tr>
                                                <td>
                                                    <div style="border: 1px dotted gray; margin: 5px; font-weight: bold; font-size:large">@item.ProductStock.OptionC</div>
                                                </td>
                                            </tr>
                                        }
                                    </table>
                                </td>
                            </tr>
                        }

                        @foreach (var bundle in Model.Order.Deliverable.DeliverableBundles)
                        {

                            <tr>
                                <td colspan="2" style="border: 1px solid ghostwhite; padding: 5px; text-align: left;">
                                    <div>@bundle.ProductItemBundle.Name</div>
                                    <ul>
                                        @foreach (var bundleItem in bundle.ProductItemBundle.ProductItemBundleJoinProductItem)
                                        {
                                            <li>
                                                <div style="word-break: break-all;">
                                                    @bundleItem.ProductItem.Name &nbsp;&#8212;&nbsp; @bundleItem.ProductItemQuantity x
                                                </div>
                                            </li>
                                        }
                                    </ul>
                                </td>
                                <td colspan="2" style="border: 1px solid ghostwhite; padding: 5px;">
                                    @foreach (var bundleItem in bundle.DeliverableBundleItems)
                                    {
                                        <table style="margin-top: 5px; width: 100%; border-bottom: 1px solid ghostwhite;" cellspacing="0" cellpadding="0">
                                            <tr>
                                                <td>@bundleItem.ProductStock.ProductItem.Name</td>
                                            </tr>
                                            <tr>
                                                <td>
                                                    <table style="border: none" cellspacing="0" cellpadding="0">
                                                        <tr>
                                                            <td>
                                                                <div style="border: 1px dotted gray; margin: 5px; font-weight: bold; font-size:large">@bundleItem.ProductStock.MainCode</div>
                                                            </td>
                                                        </tr>
                                                        @if (bundleItem.ProductStock.AuxiliaryCode != null)
                                                        {
                                                            <tr>
                                                                <td>
                                                                    <div style="border: 1px dotted gray; margin: 5px; font-weight: bold; font-size:large">@bundleItem.ProductStock.AuxiliaryCode</div>
                                                                </td>
                                                            </tr>
                                                        }
                                                        @if (bundleItem.ProductStock.OptionA != null)
                                                        {
                                                            <tr>
                                                                <td>
                                                                    <div style="border: 1px dotted gray; margin: 5px; font-weight: bold; font-size:large">@bundleItem.ProductStock.OptionA</div>
                                                                </td>
                                                            </tr>
                                                        }
                                                        @if (bundleItem.ProductStock.OptionB != null)
                                                        {
                                                            <tr>
                                                                <td>
                                                                    <div style="border: 1px dotted gray; margin: 5px; font-weight: bold; font-size:large">@bundleItem.ProductStock.OptionB</div>
                                                                </td>
                                                            </tr>
                                                        }
                                                        @if (@bundleItem.ProductStock.OptionC != null)
                                                        {
                                                            <tr>
                                                                <td>
                                                                    <div style="border: 1px dotted gray; margin: 5px; font-weight: bold; font-size:large">@bundleItem.ProductStock.OptionC</div>
                                                                </td>
                                                            </tr>
                                                        }
                                                    </table>
                                                </td>
                                            </tr>
                                        </table>
                                    }
                                </td>

                            </tr>
                        }

                    </tbody>
                </table>


                <!-- Disclaimer -->
                @if (Model.MissingItems.Any())
                {
                    <table style="border-collapse: collapse; margin-top: 10px; background-color: white; width: 600px;">
                        <thead style="background-color:ghostwhite">
                            <tr>
                                <th align="left" colspan="4" style="border:1px solid ghostwhite; padding:5px; text-align:left;">Important Notice</th>
                            </tr>
                            <tr>
                                <th align="left" colspan="4" style="border:1px solid ghostwhite; padding:5px; text-align:left;">
                                    We are sorry you did not receive all of your
                                    order items as you expected. We experienced an unusually large number of orders at a time, which disrupted our normal delivery
                                    and some items of your order went out of stock. We will deliver your remaining order items as soon as possible. Please feel free to
                                    email us at <b>support@niludigital.com</b>.
                                    Again, we apologize for any inconvenience we might have caused and look forward to filling your future orders in timely manner.
                                </th>
                            </tr>
                            <tr>
                                <th align="left" colspan="3" border:1px solid ghostwhite; padding:5px; text-align:left;">Undelivered Item Name</th>
                                <th align="left" colspan="1" border:1px solid ghostwhite; padding:5px; text-align:left;">Quantity</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.MissingItems)
                            {
                                <tr>
                                    <td align="left" colspan="3" style="border:1px solid ghostwhite; padding:5px; text-align:left;">@item.ProductItem.Name</td>
                                    <td align="left" colspan="1" style="border:1px solid ghostwhite; padding:5px; text-align:left;">@item.Quantity</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }

            </td>
        </tr>
    </table>

    <!-- Footer -->
    <table align="center" style="width: 600px; margin-top: 5px;">
        <tr>
            <td align="center">
                <div style="margin:20px 0 12px 0">
                    <div style="font-size: x-large; font-weight: bold;">
                        <b style="color: black;">@Model.ShopName</b>
                    </div>
                    <div style="margin: 5px 0 5px 0">@Model.Address1</div>
                    <div style="margin: 5px 0 5px 0">@Model.Address2</div>
                    <div style="margin: 5px 0 5px 0">
                        <a style="color:darkblue;" href="tel:@Model.ShopPhone?.Replace("-","").Replace("(","").Replace(")", "")">
                            @Model.ShopPhone
                        </a>
                        <span style="color: darkblue; padding: 0 5px 0 5px;"></span>
                        <a style="color:darkblue" href="tel:@Model.ShopPhone2?.Replace("-","").Replace("(","").Replace(")", "")">
                            @Model.ShopPhone2
                        </a>
                    </div>
                    <div style="margin: 5px 0 5px 0">
                        <a style="color: darkblue;" href="mailto:@Model.ShopEmail">@Model.ShopEmail</a>
                        <span style="color: darkblue; padding: 0 5px 0 5px;"></span>
                        <a style="color: darkblue;" href="mailto:@Model.ShopEmail2">@Model.ShopEmail2</a>
                    </div>
                </div>
            </td>
        </tr>
    </table>
</body>
</html>