@using  Digital_Services_BD.ViewModels
@model ResetPassword
@{
    ViewBag.Title = "Reset Password";
}
<div class="row m-2 flex-column">
    <div class="col-md-8 col-lg-6 border mx-auto p-3 shadow-sm rounded">
        <div class="d-flex justify-content-start">
            <h4 class="text-secondary"><i class="fas fa-undo mr-2"></i>Reset password</h4>
        </div><hr />
        <form method="post" class="form" asp-controller="Account" asp-action="ResetPassword">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="All"></div>
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="Token" />
            <div class="col-md-12 p-0">
                <label class="font-weight-bold" asp-for="Password"></label>
                <div>
                    <i class="fas fa-eye text-secondary position-absolute m-2 right-0"></i>
                    <input asp-for="Password" type="password" class="form-control" />
                </div>
                <span asp-validation-for="Password" class="d-block alert-warning-color"></span>
            </div>
            <div class="col-md-12 p-0">
                <label class="font-weight-bold" asp-for="ConfirmPassword"></label>
                <div>
                    <i class="fas fa-eye text-secondary position-absolute m-2 right-0"></i>
                    <input asp-for="ConfirmPassword" type="password" class="form-control" />
                </div>
                <span asp-validation-for="ConfirmPassword" class="d-block alert-warning-color"></span>
            </div>
            <div class="col-md-6 p-0 mt-2">
                <button type="submit" class="btn btn-secondary">Submit</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $("div i").click(function (evt) {
                if ($(evt.currentTarget).hasClass("fa-eye")) {
                    $(evt.currentTarget).removeClass("fa-eye");
                    $(evt.currentTarget).addClass("fa-eye-slash");
                    $(evt.currentTarget).siblings("input").attr("type", "text");
                }
                else if ($(evt.currentTarget).hasClass("fa-eye-slash")) {
                    $(evt.currentTarget).removeClass("fa-eye-slash");
                    $(evt.currentTarget).addClass("fa-eye");
                    $(evt.currentTarget).siblings("input").attr("type", "password");
                }
            });
        });
    </script>
}