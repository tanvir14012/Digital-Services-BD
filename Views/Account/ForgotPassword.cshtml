@using Digital_Services_BD.ViewModels
@model ResendEmail


<div class="row flex-column m-2">
    <div class="col-md-8 col-lg-6 mx-auto p-3 border shadow-sm rounded">
        @if (ViewBag.HeadingClass != null)
        {
            <div class="alert @ViewBag.HeadingClass">
                <h4 class="alert-heading">@ViewBag.Heading</h4>
                <p class="">@ViewBag.Message</p>
            </div>
        }
        <form class="form" method="post" asp-action="ForgotPassword" asp-controller="Account">
            @Html.AntiForgeryToken()
            <h4 class="text-secondary">Reset your password</h4><hr />
            <div asp-validation-summary="All"></div>
            <label class="fw-bold" asp-for="Email"></label>
            <input class="form-control" asp-for="Email" />
            <span asp-validation-for="Email" class="d-block alert-warning-color"></span>
            <button type="submit" class="btn btn-secondary mt-2">Submit</button>
        </form>
    </div>
</div>