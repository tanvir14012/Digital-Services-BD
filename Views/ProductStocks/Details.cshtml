@model ProductStock
@{
    var statusClass = new Dictionary<ProductStockStatus, string> {
        {ProductStockStatus.HALTED, "text-bg-dark" },
        {ProductStockStatus.INVALID, "text-bg-warning" },
        {ProductStockStatus.DELIVERED, "text-bg-info" },
        {ProductStockStatus.ACTIVE, "text-bg-primary" }
    };

}

<div class="row p-3 mt-5">
    <div class="col-12 p-0">
        <div class="my-2 border-0 btn btn-sm btn-light">
            <a class="nav-link text-dark" asp-action="Index" asp-controller="ProductStocks"><i class="fas fa-backward me-2"></i>Product Stocks</a>
        </div>
    </div>
    <div class="card w-100">
        <div class="card-header">
            <h5>Product Stock Details</h5>
            <div class="text-muted">Your product stock <b>#@Model.Id</b> was created on <b>@Model.CreateTime.ToString("dddd, dd MMMM yyyy")</b> and current status is <span class="badge badge-@(statusClass[Model.Status])">@Model.Status</span>.</div>
        </div>
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th style="width: 20%;">Name</th>
                        <th style="width: 80%;">Value</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var featureProperty in Model.GetType().GetProperties().Where(p => p.CanWrite))
                    {
                        if (!(featureProperty.Name == "OrderItem" || featureProperty.Name == "ProductItem"
                            || featureProperty.Name == "OrderItemId"))
                        {
                            <tr>
                                <td style="width: 20%;">@featureProperty.Name</td>
                                <td style="width: 80%;">@featureProperty.GetValue(Model, null)?.ToString()</td>
                            </tr>
                        }

                    }
                </tbody>
            </table>
        </div>
        <div class="card-footer">
            <ul class="list-group list-group-horizontal">
                <li class="list-group-item p-0 me-2">
                    <a asp-action="Delete" asp-controller="ProductStocks" asp-route-id="@Model.Id"
                       class="btn btn-danger text-white" data-toggle="tooltip" data-placement="auto" title="Edit">
                        <i class="fas fa-trash"></i>
                    </a>
                </li>
                <li class="list-group-item p-0 me-2">
                    <a asp-action="Update" asp-controller="ProductStocks" asp-route-id="@Model.Id"
                       class="btn btn-info text-white" data-toggle="tooltip" data-placement="auto" title="Delete">
                        <i class="fas fa-edit"></i>
                    </a>
                </li>
            </ul>
        </div>
    </div>
</div>


@section Scripts {
    <script>
        //Unhide
        $("li[name='showMore']").click(function (e) {
            let ul = $(e.target).closest("ul");
            $(ul).find("li").removeClass("d-none").addClass("d-flex");
            $(this).remove();
            e.preventDefault();
        });
    </script>
}