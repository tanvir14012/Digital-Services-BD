@model Order

@{
    Layout = "_PaymentSummaryLayout";
}
<div class="row p-3 mt-5">
    <ul class="list-group list-group-horizontal w-100 d-flex justify-content-between">
        <li class="list-group-item p-0 border-0">
            <div class="text-center">
                <button class="btn btn-dark rounded-circle">1</button>
                <span class="ms-2 text-nowrap">Your cart</span>
            </div>
        </li>
        <li class="list-group-item p-0 ms-2 me-2 my-auto border-start-0 border-end-0 border-bottom-0 w-25">
        </li>
        <li class="list-group-item p-0 border-0">
            <div class="text-center">
                <button class="btn btn-dark rounded-circle">2</button>
                <span class="ms-2 text-nowrap">Payment</span>
            </div>
        </li>
        <li class="list-group-item p-0 ms-2 me-2 my-auto border-start-0 border-end-0 border-bottom-0 w-25">
        </li>
        <li class="list-group-item p-0 border-0">
            <div class="text-center">
                <button class="btn btn-dark btn-outline-light rounded-circle bg-primary">3</button>
                <span class="ms-2 text-nowrap">Summary</span>
            </div>
        </li>
    </ul>
</div>

<div class="row p-2">
    <h5>Order summary</h5>
    <div class="text-muted col-12 px-0">
        <div class="alert alert-@(Model.Status == OrderStatus.CANCELLED ? "success": "secondary")">The order status is: <b>@Model.Status.ToString()</b></div>
    </div>
    <hr />
    <div class="table-responsive">
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th colspan="2">Order #@Model.Id</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td style="width: 20%;">Email Address</td>
                    <td style="width: 80%;">@Model.ConfirmEmail</td>
                </tr>
                <tr>
                    <td style="width: 20%;">Items</td>
                    <td style="width: 80%;">
                        <ul>
                            @foreach (var item in Model.OrderItems)
                            {
                                <li>@item.ProductItem.Name (@item.Quantity x)</li>
                            }
                            @foreach (var item in Model.OrderProductItemBundles)
                            {
                                <li>@item.ProductItemBundle.Name (@item.Quantity x)</li>
                            }
                        </ul>
                    </td>
                </tr>
                <tr>
                    <td style="width: 20%;">Subtotal</td>
                    <td style="width: 80%;">
                        @Model.GrandTotal.ToString("0.00") <sup>BDT</sup>
                    </td>
                </tr>

            </tbody>
        </table>
    </div>

    <div class="col-12 p-0 mt-4 d-flex">
        <div class="my-2 border-0 btn btn-sm btn-light me-2">
            <a class="nav-link text-dark" asp-action="Index" asp-controller="Orders"><i class="fas fa-shopping-bag me-2"></i>Orders</a>
        </div>
        <div class="my-2 border-0 btn btn-sm btn-light">
            <a class="nav-link text-dark" asp-action="Index" asp-controller="Home"><i class="fas fa-home me-2"></i>Home</a>
        </div>
    </div>
</div>