@using Digital_Services_BD.ViewModels
@model CartViewModel

<div class="spacer"></div>
@if (Model.Message != null)
        {
<div class="row mx-5 my-2 alert alert-dismissible alert-info fade show" role="alert">
    @Model.Message
    <button type="button" class="close" data-dismiss="alert" aria-label="Close">
        <span aria-hidden="true">&times;</span>
    </button>
</div>
        }
@if (Model != null && (Model.CartItems.Count > 0 || Model.CartItemBundlesViewModel.Count > 0))
{
    <div class="row p-3">
        
        <ul class="list-group list-group-horizontal w-100 d-flex justify-content-between">
            <li class="list-group-item p-0 border-0">
                <div class="text-center">
                    <button class="btn btn-dark rounded-circle bg-primary border-primary">1</button>
                    <span class="ml-2 text-nowrap text-white">Your cart</span>
                </div>
            </li>
            <li class="list-group-item p-0 ml-2 mr-2 my-auto border-left-0 border-right-0 border-bottom-0 w-25">
            </li>
            <li class="list-group-item p-0 border-0">
                <div class="text-center">
                    <button class="btn btn-dark rounded-circle">2</button>
                    <span class="ml-2 text-nowrap">Payment</span>
                </div>
            </li>
            <li class="list-group-item p-0 ml-2 mr-2 my-auto border-left-0 border-right-0 border-bottom-0 w-25">
            </li>
            <li class="list-group-item p-0 border-0">
                <div class="text-center">
                    <button class="btn btn-dark rounded-circle">3</button>
                    <span class="ml-2 text-nowrap">Summary</span>
                </div>
            </li>
        </ul>
    </div>

    <div class="row p-2">
        <div class="w-100 d-flex justify-content-between link-normal">
            <div>
                <h4>Cart Items</h4>
                <h6 class="ml-2">@(Model.CartItems.Count + Model.CartItemBundlesViewModel.Count) 
                    cart item@(Model.CartItems.Count + Model.CartItemBundlesViewModel.Count > 1 ? "s":""). Quantity is affected by stock availability.</h6>
            </div>
            <a asp-action="Index" asp-controller="Home"><u>continue shopping</u></a>
        </div>
        <div class="col-lg-8 col-md-12 p-0 pr-2">
            <form method="post" asp-action="EmptyCart" asp-controller="Cart">
                @Html.AntiForgeryToken()
                <input type="hidden" name="cartId" value="@Model.CartId" />
                <input type="hidden" name="userId" value="" />
                <button type="submit" class="btn btn-light float-right"><i class="fas fa-trash text-danger mr-2"></i>Empty Cart</button>
            </form>
            <div class="w-100 d-flex flex-column">
                @for (var i = 0; i < Model.CartItems.Count; i++)
                {
                    var item = Model.CartItems.ElementAt(i);
                    <div class="card mt-2">
                        <div class="card-header">
                            <h5>@(i+1). @item.ProductItem.Name</h5>
                        </div>
                        <div class="card-body w-100 row">
                            <div class="col-lg-8 col-md-12">
                                <div class="d-flex">
                                    <form method="post" asp-action="Index" asp-controller="Cart">
                                        @Html.AntiForgeryToken()
                                        <span class="mr-2 text-muted">Quantity:</span>
                                        <button type="button" name="subtractQuantity" class="btn btn-sm btn-light m-2"><i class="fas fa-minus"></i></button>
                                        <input data-name="quantity" name="cartItemIdNquantity[@i].Quantity" type="number" class="form-control-sm m-2" min="1" max="10" value="@item.Quantity" />
                                        <button type="button" name="addQuantity" class="btn btn-sm btn-light m-2"><i class="fas fa-plus"></i></button>
                                        <input type="hidden" name="cartId" value="@item.CartId" />
                                        <input type="hidden" name="cartItemIdNquantity[@i].CartItemId" value="@item.Id" />
                                        <input type="hidden" name="cartItemIdToBeDeleted" value="" />
                                        <button type="button" data-cartItemId="@item.Id" class="ml-3 btn btn-sm btn-light" name="removeBtn"><i class="fas fa-trash text-danger mr-2"></i> Remove</button>
                                    </form>
                                </div>
                                @if (item.Quantity >= @ProductConfig.MaxItemAllowedInCart)
                                {
                                    <div class="mb-2">
                                        <sub class="text-muted">Maximum allowed quantity is @ProductConfig.MaxItemAllowedInCart</sub>
                                    </div>
                                }

                            </div>
                            <div class="col-lg-4 col-md-12 pr-0">
                                <div class="d-flex flex-column justify-content-end">
                                    <h4>
                                        <strong>@string.Format("{0:0.00}", (item.Price - item.Discount + item.Vat))<sup>@item.PriceCurrency</sup></strong>
                                    </h4>
                                    @if (item.Discount > 0)
                                    {
                                        <h5>
                                            <s class="mr-1">@string.Format("{0:0.00}", (item.Price + item.Discount + item.Vat))<sup>@item.PriceCurrency</sup></s>
                                            <span class="text-danger border border-danger mt-1 d-inline-block">@string.Format("{0:0.00}", (item.Discount * 100) / (item.Price + item.Vat))% OFF</span>
                                        </h5>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }


                @for (var i = 0; i < Model.CartItemBundlesViewModel.Count; i++)
                {
                    var item = Model.CartItemBundlesViewModel.ElementAt(i);
                    <div class="card mt-2">
                        <div class="card-header">
                            <h5>@(i+1+ Model.CartItems.Count). @item.Name <i class="float-right fas fa-box"></i></h5>
                        </div>
                        <div class="card-body w-100 row">
                            <div class="col-lg-8 col-md-12">
                                <div class="d-flex ">
                                    <form method="post" asp-action="Index" asp-controller="Cart">
                                        @Html.AntiForgeryToken()
                                        <span class="mr-2 text-muted">Quantity:</span>
                                        <button type="button" name="subtractQuantity" class="btn btn-sm btn-light m-2"><i class="fas fa-minus"></i></button>
                                        <input data-name="quantity" name="cartItemBundleIdNquantity[@i].Quantity" type="number" class="form-control-sm m-2" min="1" max="10" value="@item.Quantity" />
                                        <button type="button" name="addQuantity" class="btn btn-sm btn-light m-2"><i class="fas fa-plus"></i></button>
                                        <input type="hidden" name="cartId" value="@Model.CartId" />
                                        <input type="hidden" name="cartItemBundleIdNquantity[@i].ProductItemBundleId" value="@item.ProductItemBundleId" />
                                        <input type="hidden" name="cartItemBundleIdToBeDeleted" value="" />
                                        <button type="button" data-ProductItemBundleId="@item.ProductItemBundleId" class="ml-3 btn btn-sm btn-light" name="removeBtn2"><i class="fas fa-trash text-danger mr-2"></i> Remove</button>
                                    </form>
                                </div>
                                @if (item.Quantity >= @ProductConfig.MaxItemAllowedInCart)
                                {
                                    <div class="mb-2">
                                        <sub class="text-muted">Maximum allowed quantity is @ProductConfig.MaxItemAllowedInCart</sub>
                                    </div>
                                }
                                <div class="d-flex flex-column mt-2">
                                    <span class="text-muted font-weight-bold">Package Items</span>

                                    @foreach (var individualItem in item.IndividualItemsView)
                                    {
                                        <div class="d-block">
                                            <span class="text-muted">@individualItem.ProductItemName</span>
                                            <span class="ml-2 mr-2 text-muted">&mdash;</span>
                                            <span class="text-muted">@individualItem.Quantity x</span>
                                        </div>
                                    }
                                </div>
                            </div>
                            <div class="col-lg-4 col-md-12 pr-0">
                                <div class="d-flex flex-column justify-content-end">
                                    <h4>
                                        <strong>@string.Format("{0:0.00}", (item.BundlePrice - item.BundleDiscount) * item.Quantity)<sup>@item.PriceCurrency</sup></strong>
                                    </h4>
                                    @if (item.BundleDiscount > 0)
                                    {
                                        <h5>
                                            <s class="mr-1">@string.Format("{0:0.00}", item.BundlePrice * item.Quantity)<sup>@item.PriceCurrency</sup></s>
                                            <span class="text-danger border border-danger mt-1 d-inline-block">@string.Format("{0:0.00}", (item.BundleDiscount * 100) / (item.BundlePrice))% OFF</span>
                                        </h5>
                                    }
                                </div>
                            </div>
                        </div>

                    </div>
                }
            </div>
        </div>
        <!-- Order Summary -->
        <div class="col-lg-4 col-md-12 p-0">
            <div class="card mt-2">
                <div class="card-header font-weight-bold">
                    Order Summary
                </div>
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div class="text-muted">Subtotal: </div>
                        <div><h4><strong>@string.Format("{0:0.00}", Model.Subtotal)<sup>@Model.PriceCurrency</sup></strong></h4></div>
                    </div>
                    <div class="d-flex justify-content-between">
                        <div class="text-muted">Tax and Fees: </div>
                        <div><h4><strong>@string.Format("{0:0.00}", Model.TaxesAndFees)<sup>@Model.PriceCurrency</sup></strong></h4></div>
                    </div>
                    <hr />
                    <div class="d-flex justify-content-between">
                        <div class="text-muted font-weight-bolder">Total: </div>
                        <div><h4><strong>@string.Format("{0:0.00}", Model.Total)<sup>@Model.PriceCurrency</sup></strong></h4></div>
                    </div>
                </div>
                <div class="card-body d-flex flex-column">
                    <form method="post" asp-action="Checkout" asp-controller="Cart">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="CartId" value="@Model.CartId" />
                        <div class="input-group">
                            <div class="input-group-prepend">
                                <div class="input-group-text"><i class=" fas fa-envelope"></i></div>
                            </div>
                            <input name="Email" pattern="^\w+([\.-]?\w+)*@@\w+([\.-]?\w+)*(\.\w{2,3})+$"
                                   class="form-control" type="email" title="Email address" value="@Model.UserEmail"
                                   placeholder="Enter order confirmation e-mail" required />
                            <span class="invalid-feedback">A valid e-mail address is required</span><br />
                        </div>
                        <div>
                            <small class="text-muted">Please make sure that the email address is correct</small>
                        </div>
                        <div class="form-row form-check mt-2">
                            <input id="tos-agreement" class="form-check-input" type="checkbox" />
                            <label for="tos-agreement" class="form-check-label">
                                I have read and agree to the <a href="/home/tos">Terms of Service</a>, <a href="/home/privacy">Privacy Policy</a>
                                and <a href="/home/refundpolicy">Return Refund Policy</a>.
                            </label>
                        </div>
                        <div class="form-row form-check mt-2">
                            <input name="SendOffers" id="email-promo-check" class="form-check-input" type="checkbox" value="false" />
                            <label for="email-promo-check" class="form-check-label">Send me best offers and deals through email</label>
                        </div>
                        <div class="mt-2">
                            <button id="continue-payment" type="submit" class="btn btn-primary p-2" disabled>Proceed to Checkout</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="row p-2 mt-8 d-flex flex-column justify-content-center">
        <div class="text-center">
            <i class="fas fa-cart-arrow-down text-muted" style="transform: scale(2,2);"></i>
        </div>
        <div class="text-center m-2">
            <h5>Your cart is empty! Go ahead and add some cool stuff to it!</h5>
        </div>
        <div class="text-center">
            <a asp-action="Index" asp-controller="Home" class="btn btn-dark">Browse Products</a>
        </div>
    </div>
}

@section Scripts {
    <script>
        //Add, subtract qty, disable btn
        $("button[name='addQuantity']").click(function (e) {
            var qtyNode = $($(e.target).closest("button")[0]).siblings("input[data-name='quantity']");
            $(qtyNode).val(parseInt($(qtyNode).val()) + 1);
            $(qtyNode).trigger("change");
        });
        $("button[name='subtractQuantity']").click(function (e) {
            var qtyNode = $($(e.target).closest("button")[0]).siblings("input[data-name='quantity']");
            $(qtyNode).val(parseInt($(qtyNode).val()) - 1);
            $(qtyNode).trigger("change");
        });
        $("input[data-name='quantity']").change(function (e) {
            var plus = $(e.target).siblings("button[name='addQuantity']");
            $(plus).attr('disabled', false);
            var minus = $(e.target).siblings("button[name='subtractQuantity']");
            $(minus).attr('disabled', false);

            if ($(this).val() <= 1) {
                $(this).val(1);
                $(minus).attr('disabled', true);
            }
            else if ($(this).val() >= 10) {
                $(this).val(10);
                $(plus).attr('disabled', true);
            }

            $(e.target).parent("form").submit();

        });
        $("button[name='removeBtn']").click(function (e) {
            $($(e.target).closest("button")[0]).siblings("input[name='cartItemIdToBeDeleted']").val($($(e.target).closest("button")[0]).data("cartitemid"));
            $($(e.target).closest("button")[0]).parent("form").submit();
        });
        $("button[name='removeBtn2']").click(function (e) {
            $($(e.target).closest("button")[0]).siblings("input[name='cartItemBundleIdToBeDeleted']").val($($(e.target).closest("button")[0]).data("productitembundleid"));
            $($(e.target).closest("button")[0]).parent("form").submit();
        });

        //Relaod if back navigation, to fix wrong quantity
        if (window.performance && window.performance.navigation.type === window.performance.navigation.TYPE_BACK_FORWARD) {
            location.reload();
        }

        //Agree to Tos
        $("#tos-agreement").change(function() {
            if ($(this).is(":checked")) {
                $("#continue-payment").prop("disabled", false);
            }
            else {
                $("#continue-payment").prop("disabled", true);
            }
        });
    </script>
}