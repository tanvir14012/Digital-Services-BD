@using Digital_Services_BD.ViewModels
@model CartViewModel

@if (Model != null || (Model.CartItems.Count > 0 || Model.CartItemBundlesViewModel.Count > 0))
{
    <div class="row p-3 mt-5">
        <ul class="list-group list-group-horizontal w-100 d-flex justify-content-between">
            <li class="list-group-item p-0 border-0">
                <div class="text-center">
                    <button class="btn btn-dark rounded-circle bg-primary">1</button>
                    <span class="ml-2 text-nowrap">Your cart</span>
                </div>
            </li>
            <li class="list-group-item p-0 ml-2 mr-2 my-auto border-left-0 border-right-0 border-bottom-0 w-25">
            </li>
            <li class="list-group-item p-0 border-0">
                <div class="text-center">
                    <button class="btn btn-dark rounded-circle">2</button>
                    <span class="ml-2 text-nowrap">Payment</span>
                </div>
            </li>
            <li class="list-group-item p-0 ml-2 mr-2 my-auto border-left-0 border-right-0 border-bottom-0 w-25">
            </li>
            <li class="list-group-item p-0 border-0">
                <div class="text-center">
                    <button class="btn btn-dark rounded-circle">3</button>
                    <span class="ml-2 text-nowrap">Summary</span>
                </div>
            </li>
        </ul>
    </div>

    <div class="row p-2">
        <div class="w-100 d-flex justify-content-between link-normal">
            <div>
                <h4>Cart Item/s <sub class="ml-2">(@Model.CartItems.Count item/s)</sub></h4>
            </div>
            <a asp-action="Index" asp-controller="Home">continue shopping</a>
        </div>
        <div class="col-lg-8 col-md-12 p-0">
            <div class="w-100 d-flex flex-column">
                @for (var i = 0; i < Model.CartItems.Count; i++)
                {
                    var item = Model.CartItems.ToList()[i];
                    <div class="card mt-2">
                        <div class="card-header">
                            <h4>@(i+1). @item.Name</h4>
                        </div>
                        <div class="card-body w-100 row">
                            <div class="col-lg-8 col-md-12">
                                <div class="d-flex">
                                    <span class="m-2 text-muted">Quantity: </span>
                                    <button name="subtractQuantity" class="btn btn-sm m-2"><i class="fas fa-minus"></i></button>
                                    <input type="number" class="form-control-sm m-2" min="1" max="10" value="@item.Quantity" />
                                    <button name="addQuantity" class="btn btn-sm m-2"><i class="fas fa-plus"></i></button>
                                    <button class="ml-3 btn btn-sm btn-light" name="removeItem"><i class="fas fa-trash text-danger mr-2"></i> Remove</button>
                                </div>
                            </div>
                            <div class="col-lg-4 col-md-12">
                                <div class="d-flex flex-column justify-content-end">
                                    <h4>
                                        <strong>@string.Format("{0:0.00}",(item.Price - item.Discount + item.Vat))<sup>@item.PriceCurrency</sup></strong>
                                    </h4>
                                    @if (item.Discount > 0)
                                    {
                                        <h5>
                                            <s>@string.Format("{0:0.00}", (item.Price + item.Discount + item.Vat))<sup>@item.PriceCurrency</sup></s>
                                            <span class="text-danger border border-danger ml-2">@string.Format("{0:0.00}", (item.Discount * 100) / (item.Price + item.Vat))% OFF</span>
                                        </h5>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
        <!-- Order Summary -->
        <div class="col-lg-4 col-md-12">

        </div>
    </div>
}
else
{
    <div class="row p-2 mt-8 d-flex flex-column justify-content-center">
        <div class="text-center">
            <i class="fas fa-cart-arrow-down text-muted" style="transform: scale(2,2);"></i>
        </div>
        <div class="text-center m-2">
            <h5>Your cart is empty! Go ahead and add some cool stuff to it!</h5>
        </div>
        <div class="text-center">
            <a asp-action="Index" asp-controller="Home" class="btn btn-dark">Browse Products</a>
        </div>
    </div>
}