@model Order

<div class="row p-3 mt-5">
    <ul class="list-group list-group-horizontal w-100 d-flex justify-content-between">
        <li class="list-group-item p-0 border-0">
            <div class="text-center">
                <button class="btn btn-dark rounded-circle bg-primary">1</button>
                <span class="ml-2 text-nowrap">Your cart</span>
            </div>
        </li>
        <li class="list-group-item p-0 ml-2 mr-2 my-auto border-left-0 border-right-0 border-bottom-0 w-25">
        </li>
        <li class="list-group-item p-0 border-0">
            <div class="text-center">
                <button class="btn btn-dark rounded-circle bg-primary">2</button>
                <span class="ml-2 text-nowrap">Payment</span>
            </div>
        </li>
        <li class="list-group-item p-0 ml-2 mr-2 my-auto border-left-0 border-right-0 border-bottom-0 w-25">
        </li>
        <li class="list-group-item p-0 border-0">
            <div class="text-center">
                <button class="btn btn-dark rounded-circle">3</button>
                <span class="ml-2 text-nowrap">Summary</span>
            </div>
        </li>
    </ul>
</div>


<form method="post" asp-action="Payment" asp-controller="Cart">
    <div class="row p-2">
        <div class="col-12">
            <h4 data-toggle="tooltip" data-placement="auto" title="Your billing address will show up in order invoice">Enter Billing Address</h4>
        </div>
        <input type="hidden" asp-for="@Model.Id" />
        <div class="col-12" asp-validation-summary="All"></div>
        <div class="form-group col-md-6 col-sm-12">
            <label asp-for="@Model.BillingAddress.FirstName"></label>
            <input type="text" class="form-control" asp-for="@Model.Customer.FirstName" />
        </div>
        <div class="form-group col-md-6 col-sm-12">
            <label asp-for="@Model.BillingAddress.LastName"></label>
            <input type="text" class="form-control" asp-for="@Model.Customer.LastName" />
        </div>
        <div class="form-group col-md-6 col-sm-12">
            <label asp-for="@Model.BillingAddress.AddressLineOne"></label>
            <input type="text" class="form-control" asp-for="@Model.BillingAddress.AddressLineOne" />
        </div>
        <div class="form-group col-md-6 col-sm-12">
            <label asp-for="@Model.BillingAddress.AddressLineTwo"></label>
            <input type="text" class="form-control" asp-for="@Model.BillingAddress.AddressLineTwo" />
        </div>
        <div class="form-group col-md-6 col-sm-12">
            <label asp-for="@Model.BillingAddress.Mobile"></label>
            <input type="text" class="form-control" asp-for="@Model.BillingAddress.Mobile" />
        </div>
        <div class="form-group col-md-6 col-sm-12">
            <label asp-for="@Model.BillingAddress.AltMobile"></label>
            <input type="text" class="form-control" asp-for="@Model.BillingAddress.AltMobile" />
        </div>
        <div class="form-group col-md-6 col-sm-12">
            <label asp-for="@Model.BillingAddress.Zip"></label>
            <input type="text" class="form-control" asp-for="@Model.BillingAddress.Zip" />
        </div>
        <div class="form-group col-md-6 col-sm-12">
            <label asp-for="@Model.BillingAddress.State"></label>
            <input type="text" class="form-control" asp-for="@Model.BillingAddress.State" />
        </div>
        <div class="form-group col-md-6 col-sm-12">
            <label asp-for="@Model.BillingAddress.City"></label>
            <input type="text" class="form-control" asp-for="@Model.BillingAddress.City" />
        </div>
        <input id="isAnonymous" type="hidden" asp-for="@Model.IsAnonymousOrder" />
        <div class="form-group col-md-6 col-sm-12">
            <label hidden>Action</label>
            <div class="form-control border-0">
                <button id="skip" class="btn btn-light mr-2">Skip and Continue</button>
                <button type="submit" class="btn btn-primary">Continue</button>
            </div>
        </div>
    </div>
</form>


@section Scripts {
    <script>
        $(document).ready(function () {
            $("#skip").click(function () {
                $("#isAnonymous").val(true);
                $("form").submit();
            });

            $("[data-toggle='tooltip']").tooltip();
        });
    </script>
}