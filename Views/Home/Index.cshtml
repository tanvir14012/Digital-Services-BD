@*@using Microsoft.AspNetCore.Mvc.Localization
    @inject IViewLocalizer Localizer*@
@using Digital_Services_BD.ViewModels
@model HomePageItems
@using static Digital_Services_BD.ViewModels.ProductConfig

@{
    ViewData["Title"] = "Nilu Digital";
}

<!-- Carousel -->
@if (Model.Carousel != null)
{
    <div class="row pl-3 pr-3">
        <div id="carousel" class="carousel carousel-fade slide w-100 mt-2" data-ride="carousel" data-interval="90000">
            <ul class="carousel-indicators z-8 bg-dark m-auto">
                @for (var i = 0; i < Model.Carousel.CarouselJoinCarouselImage.Count; i++)
                {
                    <li class='@(i == 0 ? "active": "")' data-target="#carousel" data-slide-to="@i"></li>
                }

            </ul>
            <div class="carousel-inner">
                @for (var i = 0; i < Model.Carousel.CarouselJoinCarouselImage.Count; i++)
                {
                    var imageSrc = Model.Carousel.CarouselJoinCarouselImage[i].ImageUrl;

                    <div class='carousel-item d-flex justify-content-center align-items-center max-h-360 overflow-hidden @(i == 0 ? "active": "")'>
                        <img class="img-fluid" src="\@imageSrc" alt="" />
                    </div>
                }
            </div>
            <!-- Prev, Next Buttons -->
            <a class="carousel-control-prev" href="#carousel" role="button" data-slide="prev">
                <span class="carousel-control-prev-icon bg-light rounded-circle scale-2x"></span>
            </a>
            <a class="carousel-control-next" href="#carousel" role="button" data-slide="next">
                <span class="carousel-control-next-icon bg-light rounded-circle scale-2x"></span>
            </a>
            <!-- Prev, Next Buttons -->
        </div>
    </div>
    <!-- Carousel-->
}

@foreach (var productSection in Model.ProductSections)
{
    var productItems = productSection.ProductItems.Where(p => p.IsActive).ToList();
    int j = -1;

    <div class="row pl-3 pr-3 mt-4 d-flex justify-content-between">
        <h4>@productSection.Title</h4>

    </div>
    <hr />
    <div class="row pl-4">
        <div class="card-deck col-12 p-0 pl-1" id="section_@productSection.Id">

            @foreach (var product in productItems)
            {
                j++;
                var priceObj = product.ProductItemPrice.FirstOrDefault(p => p.PriceCurrency == "BDT");
                @if (priceObj == null)
                {
                    continue;
                }

                <div class="col-lg-@(productItems.Count()>= MaxColumnAllowedInLandingPageSectionRow ?
                    12/MaxColumnAllowedInLandingPageSectionRow: 12/productItems.Count())
                     col-md-@(productItems.Count() >= MaxColumnAllowedInLandingPageSectionRow/2 ? 12/(MaxColumnAllowedInLandingPageSectionRow/2): 12/productItems.Count())
                     col-sm-@(productItems.Count() >= 2 ? 6: 12/productItems.Count()) py-0 px-1 m-0">
                    <div class="card p-0 m-0 mr-1 mt-2 mb-3 h-300" data-serial="@j" @(j > MaxColumnAllowedInLandingPageSectionRow - 1 ? "hidden" : "")>
                        <a class="text-decoration-none text-black d-flex flex-column h-100" asp-action="Index" asp-controller="Detail" asp-route-id="@product.Id">
                            <div class="position-absolute right-0 m-2 px-2 py-1 badge badge-pill badge-@(product.ProductStockCount.Count > 0 ? "info": "danger")">
                                @(product.ProductStockCount.Count > 0 ? "in stock": "out of stock")
                            </div>
                            <div class="overflow-hidden max-h-240">
                                <img class="img-fluid" src="\@product.ImageUrl" />
                            </div>
                            <div class="d-flex flex-grow-1">
                                <div class="w-100 align-self-end">
                                    <div class="p-1">
                                        <strong>@product.Name</strong>
                                    </div>
                                    <div class="p-1 bg-light-gray">
                                        <div class="price-font">
                                            <strong>@string.Format("{0:0.00}", priceObj.Price - priceObj.Discount)</strong>
                                            <sup>BDT</sup>
                                        </div>
                                        @if (priceObj.Discount > 0)
                                        {
                                            <div class="text-black">
                                                <s class="text-muted">@priceObj.Price</s>
                                                <sup class="text-muted">BDT</sup>
                                                <span class="ml-1 bg-primary p-1">
                                                    <span class="text-white">@string.Format("{0:0.00}", (priceObj.Discount * 100) / priceObj.Price)% OFF</span>
                                                </span>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </a>
                    </div>
                </div>
            }
        </div>
    </div>
    <div class="text-center" @(productItems.Count < 6 ? "hidden" : "")>
        <a name="showMore" class="nav-link" href="javascript:void(0)" data-container="@productSection.Id">show more</a>
    </div>
}

<!-- Bundles -->
<div class="row pl-3 pr-3 mt-4 d-flex justify-content-between">
    <h4>Package Deals (Frequently Bought)</h4>
</div>
<hr />
<div class="row pl-4">
    <div class="card-deck col-12 p-0 pl-1" id="section_9999">
        @{ 
            int idx = -1;
        }
        @foreach (var bundle in Model.Bundles)
        {
            idx++;
            var price = bundle.ProductItemBundleJoinProductItem
            .Sum(join => (join.ProductItem.ProductItemPrice.Where(p => p.PriceCurrency == "BDT").FirstOrDefault()?.Price ?? 0) * join.ProductItemQuantity);

            var discount = bundle.ProductItemBundleJoinProductItem
                .Sum(join => (join.ProductItem.ProductItemPrice.Where(p => p.PriceCurrency == "BDT").FirstOrDefault()?.Discount ?? 0) * join.ProductItemQuantity);

            var vat = bundle.ProductItemBundleJoinProductItem
                .Sum(join => (join.ProductItem.ProductItemPrice.Where(p => p.PriceCurrency == "BDT").FirstOrDefault()?.Vat ?? 0) * join.ProductItemQuantity);

            var minStock = bundle.ProductItemBundleJoinProductItem
                .Min(join => join.ProductItem.ProductStockCount.Count/join.ProductItemQuantity);

            <div class="card-deck col-lg-@(Model.Bundles.Count()>= MaxColumnAllowedInLandingPageSectionRow ?
                    12/MaxColumnAllowedInLandingPageSectionRow: 12/Model.Bundles.Count())
                     col-md-@(Model.Bundles.Count() >= MaxColumnAllowedInLandingPageSectionRow/2 ? 12/(MaxColumnAllowedInLandingPageSectionRow/2): 12/Model.Bundles.Count())
                     col-sm-@(Model.Bundles.Count() >= 2 ? 6: 12/Model.Bundles.Count()) py-0 px-1 m-0">
                <div class="card p-0 m-0 mr-1 mt-2 mb-3" data-serial="@idx" @(idx > MaxColumnAllowedInLandingPageSectionRow - 1 ? "hidden" : "")>
                    <div class="position-absolute right-0 mx-4 my-2 px-2 py-1 badge badge-pill badge-@(minStock > 0 ? "info": "danger")">
                        @(minStock > 0 ? "in stock": "out of stock")
                    </div>
                    <a class="text-decoration-none text-black d-flex flex-column h-100" asp-action="Index" asp-controller="Package" asp-route-id="@bundle.Id">
                        <div class="h-240 w-100 d-flex flex-column">
                            <div class="position-absolute w-100 h-240 right-0">
                                <img class="w-100 scale-half" height="240" src="~/ImageResources/UI/gift-ribbon.png">
                            </div>
                            @foreach (var join in bundle.ProductItemBundleJoinProductItem)
                            {
                                <img asp-append-version="true" class="obj-fit-contain"
                                     height="@(240/bundle.ProductItemBundleJoinProductItem.Count)" src="\@join.ProductItem.ImageUrl" />
                            }

                        </div>
                        <div class="d-flex flex-grow-1">
                            <div class="w-100 align-self-end">
                                <div class="p-1">
                                    <h5 class=" text-truncate">@bundle.Name</h5>
                                    <ul class="list-group list-group-flush">
                                        @foreach (var join in bundle.ProductItemBundleJoinProductItem)
                                        {
                                            <li class="list-group-item text-truncate p-0">
                                                <span class="nav-link text-truncate">@join.ProductItem.Name <span class="ml-2 badge badge-dark">@join.ProductItemQuantity x</span></span>
                                            </li>
                                        }
                                    </ul>
                                </div>
                                <div class="bg-light-gray p-1">
                                    <div class="price-font">
                                        <strong>@string.Format("{0:0.00}", (price + vat - discount) - bundle.BundleDiscount)</strong>
                                        <sup>BDT</sup>
                                    </div>
                                    @if (bundle.BundleDiscount > 0)
                                    {
                                        <div class="text-black">
                                            <s class="text-muted">@(price + vat)</s>
                                            <sup class="text-muted">BDT</sup>
                                            <span class="ml-1 bg-primary p-1">
                                                <span class="text-white">@string.Format("{0:0.00}", ((discount + bundle.BundleDiscount) * 100) / (price + vat))% OFF</span>
                                            </span>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </a>
                </div>
            </div>
        }
    </div>
</div>
<div class="text-center" @(Model.Bundles.Count < 6 ? "hidden" : "")>
    <a name="showMore" class="nav-link" href="javascript:void(0)" data-container="9999">show more</a>
</div>

@section Scripts {
    <script>

        $(document).ready(function () {

            // **************** Show More, unhides some columns when the link is clicked ***************
            var mxColumn = @MaxColumnAllowedInLandingPageSectionRow;
            var section = []; //array, stores no. of visible children of section, indexed by section Id
            $("a[name='showMore']").click(function (e) {
                var secId = parseInt($(e.currentTarget).data("container"));
                section[secId] = (section[secId] ? section[secId] : mxColumn - 1) + mxColumn;

                $("#section_" + secId).children().each(function () {
                    var s = parseInt($(this).find("[data-serial]").data("serial"));
                    if (s <= section[secId]) {
                        $(this).find("[data-serial]").attr('hidden', false);
                    }
                });
                var total = $("#section_" + secId).children().length;
                if (section[secId] >= total) {
                    $(e.currentTarget).attr("hidden", true);
                }
            });
            // **************** Show More, unhides some columns when the link is clicked ***************
        });
    </script>
}