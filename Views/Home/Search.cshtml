@using Digital_Services_BD.ViewModels
@using static Digital_Services_BD.ViewModels.ProductConfig
@model SearchView
@{
    ViewData["Title"] = $"Search: {Model.Term}";
    var pages = Math.Max(1, (int)Math.Ceiling((double)Model.TotalItems / NoOfProductItemPerPage));
    var range = Model.PriceRange?.Split("to");
    var from = range is { Length: 2 } ? range[0] : MinPrice.ToString();
    var to = range is { Length: 2 } ? range[1] : MaxPrice.ToString();
}
<nav aria-label="Breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li><li class="breadcrumb-item active" aria-current="page">Search</li></ol></nav>
<div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-4">
    <div><h1 class="h3 mb-1">Results for “@Model.Term”</h1><p class="text-secondary mb-0">@Model.TotalItems @(Model.TotalItems == 1 ? "product" : "products") found</p></div>
</div>
<form method="post" asp-controller="Home" asp-action="Search" id="searchForm">
    <input type="hidden" asp-for="Term" />
    <input type="hidden" asp-for="PriceRange" id="priceRangeInput" />
    <input type="hidden" asp-for="PageNo" id="pageNoInput" />
    <div class="row g-3 align-items-end bg-white border rounded-3 p-3 mb-4">
        <div class="col-6 col-md-3"><label class="form-label" for="priceFrom">Minimum price (BDT)</label><input id="priceFrom" class="form-control" type="number" min="0" step="1" value="@from" /></div>
        <div class="col-6 col-md-3"><label class="form-label" for="priceTo">Maximum price (BDT)</label><input id="priceTo" class="form-control" type="number" min="0" step="1" value="@to" /></div>
        <div class="col-12 col-md-2"><button type="button" id="goPrice" class="btn btn-primary w-100">Apply price</button></div>
        <div class="col-12 col-md-4"><label class="form-label" for="sortBy">Sort by</label><select asp-for="SortBy" id="sortBy" class="form-select"><option value="name">Name</option><option value="p_l_h">Price: low to high</option><option value="p_h_l">Price: high to low</option></select></div>
    </div>
    <div class="row g-3">
        @foreach (var product in Model.Products)
        {
            <div class="col-12 col-sm-6 col-lg-4 col-xl-3"><article class="card h-100"><partial name="_ProductCardContent" model="product" /></article></div>
        }
    </div>
    @if (Model.TotalItems == 0)
    {
        <div class="text-center p-5 bg-white rounded-3 border"><h2 class="h5">No matching products</h2><p class="text-secondary mb-0">Try a different search or a wider price range.</p></div>
    }
    @if (pages > 1)
    {
        <nav aria-label="Search result pages" class="mt-4"><ul class="pagination justify-content-center flex-wrap">
            <li class="page-item"><button class="page-link" type="button" data-page="1" disabled="@(Model.PageNo == 1)" aria-label="First page">«</button></li>
            @for (var page = Math.Max(1, Model.PageNo - 2); page <= Math.Min(pages, Model.PageNo + 2); page++)
            {
                <li class="page-item @(page == Model.PageNo ? "active" : "")"><button class="page-link" type="button" data-page="@(page)" aria-current="@(page == Model.PageNo ? "page" : null)">@(page)</button></li>
            }
            <li class="page-item"><button class="page-link" type="button" data-page="@pages" disabled="@(Model.PageNo == pages)" aria-label="Last page">»</button></li>
        </ul></nav>
    }
</form>
@section Scripts { <script src="~/js/SearchView.js" asp-append-version="true"></script> }
