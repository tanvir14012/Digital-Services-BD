@model List<ProductCategory>
@inject IProductItemOps productItemOps
@inject IProductGroupOps productGroupOps

@{
    var locationOrigin = Url.Action("Index", "Category", new { id = ViewBag.Id });

}
<script type="text/javascript">
        var locationOrigin = "@locationOrigin";
</script>

<div class="row mt-8 p-3">
    <ul class="breadcrumb w-100 p-0 m-0">
        <li class="breadcrumb-item">
            <a  asp-controller="Home" asp-action="Index">
                <i class="fas fa-home mr-1"></i>Home
            </a>
        </li>
        <li class="breadcrumb-item active">
            <a  href="@Url.Action("Index", "Category", new { id = 1})">
                @ViewBag.ProductGroupName
            </a>
        </li>
    </ul>
</div>
<div class="row p-2">
    <div class="col-lg-3 col-md-4 col-sm-12 pl-0">
        <div class="navbar-expand-md">
            <button class="btn btn-light navbar-toggler m-2" data-toggle="collapse" data-target="#filterContent">
                <i class="fas fa-filter"></i>
                <span>Filter</span>
            </button>
            <div class="collapse navbar-collapse" id="filterContent">
                <div id="accordion" class="w-100 link-normal">
                    <div class="card">
                        <div class="card-header p-0">
                            <button class="btn btn-light w-100 text-left pl-2" data-target="#filter1" data-toggle="collapse">
                                Price Range
                                <i class="float-right fas fa-arrow-down text-muted"></i>
                            </button>
                        </div>
                        <div class="collapse show" data-parent="#accordion" id="filter1">
                            <div class="card-body">
                                <div id="priceRange"></div>
                                <div id="priceLabel" for="priceRange" class="text-center mt-2">200<sup>BDT</sup>&nbsp;&mdash;&nbsp;1000<sup>BDT</sup></div>
                                <div id="goPrice" class="btn btn-dark">Go</div>
                            </div>
                        </div>
                    </div>

                    <div class="card">
                        <div class="card-header p-0">
                            <button class="btn btn-light w-100 text-left pl-2" data-target="#filter2" data-toggle="collapse">
                                Category
                                <i class="float-right fas fa-arrow-down text-muted"></i>
                            </button>
                        </div>
                        <div class="collapse show" data-parent="#accordion" id="filter2">
                            <div class="card-body p-0 pl-2 pr-2">
                                <ul class="list-group list-group-flush link-normal">
                                    @foreach (var productGroup in productGroupOps.GetAllProductGroups())
                                    {
                                        <li class="list-group-item p-0 pt-2">
                                            <a asp-controller="Category" asp-action="Index" asp-route-id="@productGroup.Id">@productGroup.Name</a>
                                        </li>
                                    }

                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-9 col-md-8 col-sm-12">
        <h4>@ViewBag.ProductGroupName</h4>
        <div class="form-row d-flex justify-content-end">
            <label class="mr-2 pt-1">Sort By</label>
            <select id="sortBy" class="selectpicker">
                <option value="m_p" selected>Most Popular</option>
                <option value="p_l_h">Price Low &rarr; High</option>
                <option value="p_h_l">Price High &rarr; Low</option>
            </select>
        </div>
        <hr />
        <div class="card-deck row">
            @for (var i = 0; i < Model.Count; i++)
            {
                <div class="col-lg-4 col-md-6 col-sm-12 pr-0">
                    <div class="card m-2 link-normal">
                        <a class="text-decoration-none text-black" asp-action="Details" asp-controller="Product">
                            <div class="d-flex justify-content-center align-items-center">
                                <img class="img-fluid h-240" src="\@Model[i].ImageUrl" />
                            </div>
                            <div class="card-body p-1">
                                <h5>@Model[i].Name</h5>
                                <ul class="list-group list-group-horizontal form-row">
                                    <li class="list-group-item list-unstyled p-0 border-0">
                                        <span class="btn btn-light" data-toggle="tooltip" data-placement="auto" title="@Model[i].Overview">
                                            <i class="fas fa-book"></i>
                                            Overview
                                        </span>
                                    </li>
                                    <li class="list-group-item list-unstyled p-0 border-0">
                                        <span class="btn btn-light" data-toggle="tooltip" data-placement="auto" title="@Model[i].WhatCanBeDone">
                                            <i class="fas fa-book"></i>
                                            What's Interesting ?
                                        </span>
                                    </li>
                                    <li class="list-group-item list-unstyled p-0 border-0">
                                        <span class="btn btn-light" data-toggle="tooltip" data-placement="auto" title="@Model[i].HowToConsume">
                                            <i class="fas fa-book"></i>
                                            How To Use ?
                                        </span>
                                    </li>
                                    <li class="list-group-item list-unstyled p-0 border-0">
                                        <span class="btn btn-light" data-toggle="tooltip" data-placement="auto" title="@Model[i].Limitations">
                                            <i class="fas fa-book"></i>
                                            Any Pitfall ?
                                        </span>
                                    </li>
                                </ul>
                            </div>
                            <div class="card-footer p-1">
                                <div class="price-font">
                                    From
                                    <strong>@string.Format("{0:0.00}", 2.3, 56.3)</strong>
                                    <sup>BDT</sup><br />
                                    To
                                    <strong>@string.Format("{0:0.00}", 202.0, 25.5)</strong>
                                    <sup>BDT</sup>
                                </div>
                            </div>
                        </a>
                    </div>
                </div>
            }
        </div>
        <div class="row d-flex justify-content-center">
            <ul class="pagination">
                @if (ViewBag.PageNo >= 2)
                {
                    <li class="page-item">
                        <a class="page-link" asp-controller="Category" asp-action="Index" asp-route-id="@ViewBag.Id"
                           asp-route-pageNo="@(ViewBag.PageNo-1)">&laquo; &nbsp; Previous</a>
                    </li>
                }
                @if (ViewBag.PageNo < 5)
                {
                    @for (var i = 1; i <= ViewBag.PageNo; i++)
                    {
                        <li class="page-item @(i == ViewBag.PageNo ? "active": "")">
                            <a class="page-link" asp-controller="Category" asp-action="Index" asp-route-id="@ViewBag.Id"
                               asp-route-pageNo="@i">@i</a>
                        </li>
                    }
                }
                else
                {
                    <li class="page-item">
                        ...
                    </li>
                    @for (var i = ViewBag.PageNo - 2; i >= ViewBag.PageNo; i--)
                    {
                        <li class="page-item @(i == ViewBag.PageNo ? "active": "")">
                            <a class="page-link" asp-controller="Category" asp-action="Index" asp-route-id="@ViewBag.Id"
                               asp-route-pageNo="@i">i</a>
                        </li>
                    }
                }

                @if (ViewBag.PageNo > (ViewBag.TotalCategory / 12) - 4)
                {
                    @for (var i = ViewBag.PageNo; i <= (ViewBag.TotalCategory / 12); i++)
                    {
                        <li class="page-item @(i == ViewBag.PageNo ? "active": "")">
                            <a class="page-link" asp-controller="Category" asp-action="Index" asp-route-id="@ViewBag.Id" asp-route-pageNo="@i">@i</a>
                        </li>
                    }
                }
                else
                {
                    @for (var i = ViewBag.PageNo; i <= ViewBag.PageNo + 2; i++)
                    {
                        <li class="page-item @(i == ViewBag.PageNo ? "active": "")">
                            <a class="page-link" asp-controller="Category" asp-action="Index" asp-route-id="@ViewBag.Id" asp-route-pageNo="@i">@i</a>
                        </li>
                    }
                    <li class="page-item">
                        ...
                    </li>
                }
                @if (ViewBag.PageNo <= (ViewBag.TotalCategory / 12) - 2)
                {
                    <li class="page-item">
                        <a class="page-link" asp-controller="Category" asp-action="Index" asp-route-id="@ViewBag.Id"
                           asp-route-pageNo="@(ViewBag.PageNo-1)">&raquo; &nbsp; Next</a>
                    </li>
                }
            </ul>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('[data-toggle="tooltip"]').tooltip();
            //Select change
            $("#sortBy").change(function () {
                window.location.href = locationOrigin + "?sortBy=" + $(this).val();
            });
            //Price slider
            $("#priceRange").slider({
                range: true,
                min: 200,
                max: 8000,
                values: [200, 1000],
                slide: function (event, ui) {
                    $("#priceLabel").html(ui.values[0].toString() + "<sup>BDT</sup>&nbsp;&mdash;&nbsp;"  + ui.values[1].toString() + "<sup>BDT</sup>");
                }
            });
            //Price submit
            $("#goPrice").click(function () {
                window.location.href = locationOrigin + "?sortBy=" + $("#sortBy").val() + "&priceRange=" +
                    $("#priceRange").slider("option", "values")[0] + "to" + $("#priceRange").slider("option", "values")[1];
            });
        });
    </script>
}