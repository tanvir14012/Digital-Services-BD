@model ProductItem

@{
    var priceObj = Model.ProductItemPrice.Where(p => p.PriceCurrency == "BDT").FirstOrDefault();
}



<div class="row mt-8 p-2">
    <!-- Left sidebar (image) -->
    <div class="col-lg-3 col-md-6 col-sm-12">
        <div class="h-240">
            <img class="img-fluid img-thumbnail" src="\@Model.ImageUrl" />
        </div>
    </div>
    <!-- Left sidebar (image)-->
    <!-- Middle content (description) -->
    <div class="col-lg-6 col-md-6 col-sm-12">
        <h4>@Model.Name</h4>
        <div class="form-row">
            <div class="col-sm-6">
                <span class="text-muted">Region: </span>@Model.ProductItemFeature.RegionCodes
            </div>
            <div class="col-sm-6">
                <span class="text-muted">Key For: </span>@Model.ProductItemFeature.Company
            </div>
        </div>
        <div class="form-row">
            <div class="col-sm-12">
                <span class="text-muted">Supported Country: </span>@Model.ProductItemFeature.RegionCountries
            </div>
        </div>
        <div class="form-row">
            <div class="col-sm-12">
                <h6 class="text-muted">Overview</h6>
                @Model.Overview
            </div>
        </div>
    </div>
    <!-- Middle content (description)-->
    <!-- Right sidebar (cart) -->
    <div class="col-lg-3 col-md-12 col-sm-12">
        <h4 class="mt-2">
            <strong class="text-muted mr-2">Price:</strong>
            <strong>@string.Format("{0: 0.00}", priceObj.Price - priceObj.Discount)<sup>BDT</sup></strong>
        </h4>
        @if (priceObj.Discount > 0)
        {
            <h5 class="mt-2 p-1">
                <s>@string.Format("{0: 0.00}", priceObj.Price)</s><sup>BDT</sup>
                <span class="ml-2 border text-danger border-danger font-weight-bold">@string.Format("{0:0.00}", priceObj.Discount * 100 / priceObj.Price)% OFF</span>
            </h5>
        }
        <div class="mt-3">
            <a class="btn btn-light">
                <i class="fas fa-cart-plus text-primary mr-2"></i>Add to Cart
            </a>
            <a class="btn btn-light">
                <i class="fas fa-shopping-bag text-info mr-2"></i>Buy Now
            </a>
        </div>
    </div>
    <!-- Right sidebar (cart)-->
    <!-- Description -->
</div>
<h5 class="pl-2">Product Information</h5>
<hr class="ml-2"/>
<div class="row p-2">

    <div class="col-md-6 col-sm-12">
        <label class="text-muted font-weight-bold">Description</label>
        <div>
            @Model.ProductItemFeature.Description
        </div>
    </div>
    <div class="col-md-6 col-sm-12">
        <label class="text-muted font-weight-bold">Key Benefits</label>
        <div>
            @Model.WhatCanBeDone
        </div>
    </div>
    <div class="col-md-6 col-sm-12">
        <label class="text-muted font-weight-bold">Instruction</label>
        <div>
            @Model.HowToConsume
        </div>
    </div>
    <div class="col-md-6 col-sm-12">
        <label class="text-muted font-weight-bold">Limitation</label>
        <div>
            <i class="fas fa-exclamation-triangle text-warning mr-2"></i>
            @Model.Limitations
        </div>
    </div>
    <div class="col-12 p-0">
        <table class="table table-responsive  table-borderless">
            <thead>
                <tr>
                    <th class="text-muted">Feature Name</th>
                    <th class="text-muted">Information</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.ProductItemFeature.Publisher != null)
                {
                    <tr>
                        <td>Publisher</td>
                        <td>@Model.ProductItemFeature.Publisher</td>
                    </tr>
                }
                @if (Model.ProductItemFeature.Developer != null)
                {
                    <tr>
                        <td>Developer</td>
                        <td>@Model.ProductItemFeature.Developer</td>
                    </tr>
                }

            </tbody>
        </table>
    </div>
</div>
<!-- Description -->