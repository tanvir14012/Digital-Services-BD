@using Microsoft.AspNetCore.Identity
@using Microsoft.Extensions.Configuration
@using Microsoft.AspNetCore.Authorization
@inject SignInManager<Customer> signInManager
@inject IConfiguration configuration
@inject IAuthorizationService authorizationService
@{
    Layout = "AdminLayout";
}

@if (signInManager.IsSignedIn(User) && (authorizationService.AuthorizeAsync(User, "AdminFullAccess").Result.Succeeded))
{
    <h4 class="text-secondary mt-4">Administrator Area</h4>
    <hr>
    <div class="row p-2 mt-4">
        <div class="col-lg-4 col-md-2 mb-1">
            <a asp-action="Carousel" asp-controller="Admin" class="d-block btn-light p-2 text-decoration-none text-secondary">
                <i class="mr-2 btn btn-sm btn-light fas fa-image text-info"></i>
                <span>Carousel</span>
            </a>
        </div>
        <div class="col-lg-4 col-md-2 mb-1">
            <a asp-action="ProductGroup" asp-controller="Admin" class="d-block btn-light p-2 text-decoration-none text-secondary">
                <i class="mr-2 btn btn-sm btn-light fas fa-folder-plus text-info"></i>
                <span>Product Group</span>
            </a>
        </div>
        <div class="col-lg-4 col-md-2 mb-1">
            <a asp-action="ProductCategory" asp-controller="Admin" class="d-block btn-light p-2 text-decoration-none text-secondary">
                <i class="mr-2 btn btn-sm btn-light fas fa-list text-info"></i>
                <span>Product Category</span>
            </a>
        </div>
        <div class="col-lg-4 col-md-2 mb-1">
            <a asp-action="ProductSection" asp-controller="Admin" class="d-block btn-light p-2 text-decoration-none text-secondary">
                <i class="mr-2 btn btn-sm btn-light fas fa-folder text-info"></i>
                <span>Product Section</span>
            </a>
        </div>
        <div class="col-lg-4 col-md-2 mb-1">
            <a asp-action="ProductItem" asp-controller="Admin" class="d-block btn-light p-2 text-decoration-none text-secondary">
                <i class="mr-2 btn btn-sm btn-light fas fa-file text-info"></i>
                <span>Product Item</span>
            </a>
        </div>
    </div>
}
