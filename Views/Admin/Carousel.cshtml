@model List<Carousel>
@{
    Layout = "AdminLayout";
}

<div class="row d-flex justify-content-between mt-4 ps-4 pe-4">
    <h4 class="text-secondary">Administrator Area for Carousels</h4>
    <a class="btn btn-light" asp-action="CreateCarousel" asp-controller="Admin">
        <i class="fas fa-plus"></i>
        <span class="ms-2">Create</span>
    </a>
</div>
<div class="row p-2">
    @if (Model.Count == 0)
    {
        <h4>There is no Carousel in Database</h4>
    }
    @foreach (var carousel in Model)
    {
        <div class="col-lg-4 col-md-6 col-sm-12 card-group">
            <div class="card m-1">
                <div class="card-header">
                    <span>@carousel.Name</span>
                </div>
                <div class="card-body row">
                    @foreach (var image in carousel.CarouselJoinCarouselImage)
                    {
                        <div class="col-5 m-1">
                            <img asp-append-version="true" height="100" class="w-100 h-100 img-mythumbnail" alt="No Image" src="\@image.ImageUrl" />
                        </div>
                    }
                </div>
                <div class="card-footer">
                    <ul class="list-group list-group-horizontal">
                        <li class="list-group-item p-0 me-2">
                            <a asp-action="ViewCarousel" asp-controller="Admin" asp-route-id="@carousel.Id"
                               class="btn btn-primary text-white" data-toggle="tooltip" data-placement="auto" title="Show">
                                <i class="fas fa-eye"></i>
                            </a>
                        </li>
                        <li class="list-group-item p-0 me-2">
                            <a asp-action="EditCarousel" asp-controller="Admin" asp-route-id="@carousel.Id"
                               class="btn btn-info text-white" data-toggle="tooltip" data-placement="auto" title="Edit">
                                <i class="fas fa-edit"></i>
                            </a>
                        </li>
                        <li class="list-group-item p-0 me-2">
                            <a asp-action="DeleteCarousel" asp-controller="Admin" asp-route-id="@carousel.Id"
                               class="btn btn-danger text-white" data-toggle="tooltip" data-placement="auto" title="Delete">
                                <i class="fas fa-trash"></i>
                            </a>
                        </li>

                    </ul>
                </div>
            </div>
        </div>
    }

</div>
@section Scripts {
    <script>
        $(document).ready(function () {
            $('[data-toggle="tooltip"]').tooltip();
        });
    </script>
}