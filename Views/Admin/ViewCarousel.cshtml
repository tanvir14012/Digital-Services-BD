@model Carousel
@{
    Layout = "AdminLayout";
}

<div class="row p-2">
    <h4 class="col-sm-12 text-secondary mb-2 pl-0">Administrator View of a Carousel</h4>
        <div class="card m-1">
            <div class="card-header">
                <span>@Model.Name</span>
            </div>
            <div class="card-body row">
                @foreach (var image in Model.CarouselJoinCarouselImage)
                {
                    <div class="col-6">
                        <img asp-append-version="true" class="img-fluid img-mythumbnail m-1" alt="No Image" src="\@image.ImageUrl" />
                    </div>
                }
            </div>
            <div class="card-footer">
                <ul class="list-group list-group-horizontal">
                    <li class="list-group-item p-0 mr-2">
                        <a asp-action="EditCarousel" asp-controller="Admin" asp-route-id="@Model.Id"
                           class="btn btn-info text-white" data-toggle="tooltip" data-placement="auto" title="Edit">
                            <i class="fas fa-edit"></i>
                        </a>
                    </li>
                    <li class="list-group-item p-0 mr-2">
                        <a asp-action="DeleteCarousel" asp-controller="Admin" asp-route-id="@Model.Id"
                           class="btn btn-danger text-white" data-toggle="tooltip" data-placement="auto" title="Delete">
                            <i class="fas fa-trash"></i>
                        </a>
                    </li>

                </ul>
            </div>
        </div>
    </div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('[data-toggle="tooltip"]').tooltip();
        });
    </script>
}