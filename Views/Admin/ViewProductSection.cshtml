@model ProductSection
@using Digital_Services_BD.Services

@{
    Layout = "AdminLayout";
    List<ProductItem> items = ViewBag.Items;
}

<div class="row justify-content-center align-items-center mt-4 p-2">
    <h4 class="col-sm-12 text-secondary mb-2">Administrator View of a Product Section</h4>
    <div class="col-sm-12">
        <div class="card">
            <div class="card-header">
                <span class="me-2">@Model.Id</span>
                <span>@Model.Title</span>
            </div>
            <div class="card-body row">
                <span class="col-md-6">Created on: @Model.CreatedOn</span>
                <span class="col-md-6">Last Modified on: @Model.LastModifiedOn</span>
            </div>
            <div class="card-body">
                <h4>Overview</h4><hr />
                <p>@Model.Overview</p>

                <h4>Product Items</h4><hr />
                <div class="table-responsive">
                    <table class="table table-bordered">
                        <thead>
                            @if (items.Count() > 0)
                            {
                                <tr>
                                    <th style="width: 10%;">Logo</th>
                                    <th style="width: 30%;">Name</th>
                                    <th style="width: 40%;">Overview</th>
                                    <th style="width: 20%;">Timestamp</th>
                                </tr>
                            }
                            else
                            {
                                <tr>
                                    <th colspan="4">
                                        <h4>The product section has no item</h4>
                                    </th>
                                </tr>
                            }

                        </thead>
                        <tbody>
                            @foreach (var item in items)
                            {
                                <tr>
                                    <td style="width: 10%;">
                                        <img class="img-mythumbnail" width="32" height="32" src="\@item.ImageUrl" />
                                    </td>
                                    <td style="width: 30%;">@item.Name</td>
                                    <td style="width: 40%;">@item.Overview</td>
                                    <td style="width: 20%;">
                                        <span><i>Created:</i> @item.CreatedOn</span><br />
                                        <span><i>Last modified:</i> @item.LastModifiedOn</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="card-footer">
                <ul class="list-group list-group-horizontal">
                    <li class="list-group-item p-0 me-2">
                        <a asp-action="EditProductSection" asp-controller="Admin" asp-route-id="@Model.Id"
                           class="btn btn-info text-white" data-toggle="tooltip" data-placement="auto" title="Edit">
                            <i class="fas fa-edit"></i>
                        </a>
                    </li>
                    <li class="list-group-item p-0 me-2">
                        <a asp-action="DeleteProductSection" asp-controller="Admin" asp-route-id="@Model.Id"
                           class="btn btn-danger text-white" data-toggle="tooltip" data-placement="auto" title="Delete">
                            <i class="fas fa-trash"></i>
                        </a>
                    </li>
                    <li class="list-group-item p-0 me-2">
                        <a asp-action="ProductSection" asp-controller="Admin"
                           class="btn btn-secondary text-white" data-toggle="tooltip" data-placement="auto" title="Back to product section">
                            <i class="fas fa-backward"></i>
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('[data-toggle="tooltip"]').tooltip();
        });
    </script>
}