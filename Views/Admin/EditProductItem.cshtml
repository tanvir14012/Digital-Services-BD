@model ProductItemViewModel
@using Digital_Services_BD.Services

@{
    Layout = "AdminLayout";
    List<ProductCategory> thisItemCategories = ViewBag.ThisItemCategories;
    List<ProductCategory> allCategories = ViewBag.AllCategories;
}

<div class="row justify-content-center align-items-center mt-4 p-2">
    <div class="col-sm-12">
        <form enctype="multipart/form-data" method="post" asp-controller="Admin"
              asp-action="EditProductItem" class="border mt-4 p-4 rounded">
            @Html.AntiForgeryToken()
            <h4 class="mb-3">Edit a Product Item</h4>
            <div class="alert-danger rounded" asp-validation-summary="All"></div>
            <div class="form-group">
                <label asp-for="Name">@Html.DisplayNameFor(m => m.Name)</label>
                <input class="form-control" type="text" asp-for="Name" />
                <span class="text-danger" asp-validation-for="Name"></span>
            </div>
            <div class="form-group">
                <label>Image Preview</label><br />
                <img class="img-thumbnail w-auto max-h-240 d-flex mx-auto" src="\@Model.ImageUrl" id="thumbnail" alt="No image" />
            </div>
            <div class="form-group">
                <label asp-for="Image">@Html.DisplayNameFor(m => m.Image)</label>
                <div class="d-flex flex-column gap-2">
                    <input id="imageFile" class="form-control" type="file" asp-for="Image" />
                    <label id="fileName" class="form-label" for="imageFile">Choose photo..</label>
                </div>
                <span class="text-danger" asp-validation-for="Image"></span>
            </div>
            <div class="row m-4">
                <div class="form-check col-sm-6">
                    <input type="checkbox" class="form-check-input" asp-for="IsActive" />
                    <label class="form-check-label" asp-for="IsActive">Is active ?</label>
                </div>
                <div class="form-check col-sm-6">
                    <input type="checkbox" class="form-check-input" asp-for="IsShippable" />
                    <label class="form-check-label" asp-for="IsShippable">Is shipable ?</label>
                </div>
            </div>
            <div class="form-group">
                <label asp-for="Overview">@Html.DisplayNameFor(m => m.Overview)</label>
                <textarea class="form-control" asp-for="Overview"></textarea>
                <span class="text-danger" asp-validation-for="Overview"></span>
            </div>
            <div class="form-group">
                <label asp-for="WhatCanBeDone">@Html.DisplayNameFor(m => m.WhatCanBeDone)</label>
                <textarea class="form-control" asp-for="WhatCanBeDone"></textarea>
                <span class="text-danger" asp-validation-for="WhatCanBeDone"></span>
            </div>
            <div class="form-group">
                <label asp-for="HowToConsume">@Html.DisplayNameFor(m => m.HowToConsume)</label>
                <textarea class="form-control" asp-for="HowToConsume"></textarea>
                <span class="text-danger" asp-validation-for="HowToConsume"></span>
            </div>
            <div class="form-group">
                <label asp-for="Limitations">@Html.DisplayNameFor(m => m.Limitations)</label>
                <textarea class="form-control" asp-for="Limitations"></textarea>
                <span class="text-danger" asp-validation-for="Limitations"></span>
            </div>
            <div class="form-group">
                <h4>Product Price</h4><hr />
                @for (var i = 0; i < SupportedCurrencies.Currencies.Count; i++)
                {
                    <ul class="list-group list-group-horizontal-md list-unstyled mt-1">
                        <li class="list-group-item d-flex flex-column bordr-0 m-1">
                            <label>Currency</label>
                            <input class="form-control input-disabled" type="text" value="@SupportedCurrencies.Currencies[i]"
                                   asp-for="ProductItemPrice[i].PriceCurrency" />
                        </li>
                        <li class="list-group-item d-flex flex-column bordr-0 m-1">
                            <label>Price</label>
                            <input class="form-control" asp-for="ProductItemPrice[i].Price" type="number" required />
                        </li>
                        <li class="list-group-item d-flex flex-column bordr-0 m-1">
                            <label>Discount</label>
                            <input class="form-control" asp-for="ProductItemPrice[i].Discount" type="number" required />
                        </li>
                        <li class="list-group-item d-flex flex-column bordr-0 m-1">
                            <label>Vat</label>
                            <input asp-for="ProductItemPrice[i].Vat" class="form-control" type="number" required />
                        </li>
                    </ul>
                    <!-- Store Id,CreatedOn in hidden field-->
                    <input type="hidden" asp-for="ProductItemPrice[i].Id" />
                    <input type="hidden" asp-for="ProductItemPrice[i].CreatedOn" />
                }
            </div>
            <div class="form-group table-responsive">
                <h4>Categories</h4><hr />
                <table class="table table-bordered">
                    <thead>
                        @if (allCategories.Count() > 0)
                        {
                            <tr>
                                <th style="width: 10%;">Inclusion</th>
                                <th style="width: 10%;">Logo</th>
                                <th style="width: 20%;">Name</th>
                                <th style="width: 40%;">Overview</th>
                                <th style="width: 20%;">Timestamp</th>
                            </tr>
                        }
                        else
                        {
                            <tr>
                                <th colspan="5">
                                    <h4>There is no category in database</h4>
                                </th>
                            </tr>
                        }

                    </thead>
                    <tbody>
                        @foreach (var category in allCategories)
                        {
                            var isCatgIncluded = thisItemCategories.Where(c => c.Id == category.Id).Count() > 0;
                            <tr>
                                <td style="width: 10%;">
                                    <div class="form-check">
                                        <!-- name must match the [BindProperty] property in model -->
                                        <input class="form-check-input" name="CategoryIds" type="checkbox" id="@category.Id"
                                               value="@category.Id" @(isCatgIncluded ? "checked" : "") />
                                        <label for="@category.Id" class="form-check-label">Include? </label>
                                    </div>
                                </td>
                                <td style="width: 10%;">
                                    <img class="img-mythumbnail" width="32" height="32" src="\@category.ImageUrl" />
                                </td>
                                <td style="width: 20%;">@category.Name</td>
                                <td style="width: 40%;">@category.Overview</td>
                                <td style="width: 20%;">
                                    <span><i>Created:</i> @category.CreatedOn</span><br />
                                    <span><i>Last modified:</i> @category.LastModifiedOn</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="row">
                <div class="form-group col-12">
                    <h4>Product Features</h4><hr />
                </div>
                <div class="form-group col-lg-6 col-md-12">
                    <label asp-for="ProductItemFeature.Company">Company</label>
                    <input class="form-control " type="text" asp-for="ProductItemFeature.Company" />
                    <span class="text-danger" asp-validation-for="ProductItemFeature.Company"></span>
                </div>
                <div class="form-group col-lg-6 col-md-12">
                    <label asp-for="ProductItemFeature.Developer">Developer</label>
                    <input class="form-control " type="text" asp-for="ProductItemFeature.Developer" />
                    <span class="text-danger" asp-validation-for="ProductItemFeature.Developer"></span>
                </div>
                <div class="form-group col-lg-6 col-md-12">
                    <label asp-for="ProductItemFeature.Publisher">Publisher</label>
                    <input class="form-control " type="text" asp-for="ProductItemFeature.Publisher" />
                    <span class="text-danger" asp-validation-for="ProductItemFeature.Publisher"></span>
                </div>
                <div class="form-group col-lg-6 col-md-12">
                    <label asp-for="ProductItemFeature.ReleaseDate">ReleaseDate</label>
                    <input id="releaseDate" class="form-control " type="datetime" asp-for="ProductItemFeature.ReleaseDate" />
                    <span class="text-danger" asp-validation-for="ProductItemFeature.ReleaseDate"></span>
                </div>
                <div class="form-group col-lg-12">
                    <label asp-for="ProductItemFeature.Description">Description</label>
                    <textarea class="form-control" type="datetime" asp-for="ProductItemFeature.Description"></textarea>
                    <span class="text-danger" asp-validation-for="ProductItemFeature.Description"></span>
                </div>
                <div class="form-group col-lg-6 col-md-12">
                    <label asp-for="ProductItemFeature.DeliveryInfo">Delivery Info</label>
                    <input class="form-control " type="datetime" asp-for="ProductItemFeature.DeliveryInfo" />
                    <span class="text-danger" asp-validation-for="ProductItemFeature.DeliveryInfo"></span>
                </div>
                <div class="form-group col-lg-6 col-md-12">
                    <label asp-for="ProductItemFeature.ValidityPeriod">Validity Period</label>
                    <input class="form-control " type="datetime" asp-for="ProductItemFeature.ValidityPeriod" />
                    <span class="text-danger" asp-validation-for="ProductItemFeature.ValidityPeriod"></span>
                </div>
                <div class="form-group col-lg-6 col-md-12">
                    <label asp-for="ProductItemFeature.DownloadSize">Download Size</label>
                    <input class="form-control " type="datetime" asp-for="ProductItemFeature.DownloadSize" />
                    <span class="text-danger" asp-validation-for="ProductItemFeature.DownloadSize"></span>
                </div>
                <div class="form-group col-lg-6 col-md-12">
                    <label asp-for="ProductItemFeature.Genre">Genres</label>
                    <select class="selectpicker form-control" asp-for="ProductItemFeature.Genre"
                            asp-items="new List<SelectListItem>(DropdownLists.Genres.Select(r => new SelectListItem(r, r)))" data-live-search="true" multiple="multiple">
                    </select>
                    <span class="text-danger" asp-validation-for="ProductItemFeature.Genre"></span>
                </div>
                <div class="form-group col-lg-6 col-md-12">
                    <label asp-for="ProductItemFeature.RegionCodes">Region Codes</label>
                    <select class="selectpicker form-control" asp-for="ProductItemFeature.RegionCodes"
                            asp-items="new List<SelectListItem>(DropdownLists.RegionCodes.Select(r => new SelectListItem(r, r)))" data-live-search="true" multiple>
                    </select>
                    <span class="text-danger" asp-validation-for="ProductItemFeature.RegionCodes"></span>
                </div>
                <div class="form-group col-lg-6 col-md-12">
                    <label asp-for="ProductItemFeature.RegionCountries">Region Countries</label>
                    <select class="selectpicker form-control" asp-for="ProductItemFeature.RegionCountries"
                            asp-items="new List<SelectListItem>(DropdownLists.RegionCountries.Select(r => new SelectListItem(r, r)))" data-live-search="true" multiple>
                    </select>
                    <span class="text-danger" asp-validation-for="ProductItemFeature.RegionCountries"></span>
                </div>
                <div class="form-group col-lg-6 col-md-12">
                    <label asp-for="ProductItemFeature.Os"></label>
                    <select class="selectpicker form-control" asp-for="ProductItemFeature.Os"
                            asp-items="new List<SelectListItem>(DropdownLists.Os.Select(r => new SelectListItem(r, r)))" data-live-search="true" multiple>
                    </select>
                    <span class="text-danger" asp-validation-for="ProductItemFeature.Os"></span>
                </div>
                <div class="form-group col-lg-6 col-md-12">
                    <label asp-for="ProductItemFeature.RequirementCpu">Minimum CPU Requirement</label>
                    <input class="form-control " type="datetime" asp-for="ProductItemFeature.RequirementCpu" />
                    <span class="text-danger" asp-validation-for="ProductItemFeature.RequirementCpu"></span>
                </div>
                <div class="form-group col-lg-6 col-md-12">
                    <label asp-for="ProductItemFeature.RequirementGpu">Minimum GPU Requirement</label>
                    <input class="form-control " type="datetime" asp-for="ProductItemFeature.RequirementGpu" />
                    <span class="text-danger" asp-validation-for="ProductItemFeature.RequirementGpu"></span>
                </div>
                <div class="form-group col-lg-6 col-md-12">
                    <label asp-for="ProductItemFeature.RequirementRam">Minimum RAM Requirement</label>
                    <input class="form-control " type="datetime" asp-for="ProductItemFeature.RequirementRam" />
                    <span class="text-danger" asp-validation-for="ProductItemFeature.RequirementRam"></span>
                </div>
                <div class="form-group col-lg-6 col-md-12">
                    <label asp-for="ProductItemFeature.RequirementDisk">Minimum Disk-space Requirement</label>
                    <input class="form-control " type="datetime" asp-for="ProductItemFeature.RequirementDisk" />
                    <span class="text-danger" asp-validation-for="ProductItemFeature.RequirementDisk"></span>
                </div>
                <!-- Bind 'Id', 'CreatedOn' in hidden field-->
                <input type="hidden" asp-for="ProductItemFeature.Id" />
                <input type="hidden" asp-for="ProductItemFeature.CreatedOn" />
            </div>

            <!-- Custom fields -->
            <div id="customFields">
                <div class="mt-2">
                    <h4>Custom Fields</h4><hr />
                </div>
                @for (var i = 0; i < Model.ProductItemCustomFieldsViewModel.Count; i++)
                {
                    <div class="form-group row" data-index=@i>
                        <div class="col-5">
                            <input class="form-control" type="text" value="@Model.ProductItemCustomFieldsViewModel[i].Key"
                                   name="ProductItemCustomFieldsViewModel[@i].Key" />
                        </div>
                        <div class="col-6">
                            <input class="form-control" type="text" value="@Model.ProductItemCustomFieldsViewModel[i].Value"
                                   name="ProductItemCustomFieldsViewModel[@i].Value" />
                        </div>
                        <div class="col-1 d-flex justify-content-center">
                            <button type="button" name="removeField" class="btn btn-sm btn-light mt-1">
                                <i class="fas fa-trash text-danger"></i>
                            </button>
                        </div>
                        <!-- Id fields as hidden input -->
                        <input type="hidden" value="@Model.ProductItemCustomFieldsViewModel[i].Id"
                               name="ProductItemCustomFieldsViewModel[@i].Id" />
                        <input type="hidden" value="@Model.ProductItemCustomFieldsViewModel[i].ProductItemId"
                               name="ProductItemCustomFieldsViewModel[@i].ProductItemId" />
                    </div>

                }
            </div>

            <div class="row justify-content-end">
                <button id="addField" type="button" class="btn btn-light m-2"><i class="fas fa-plus me-2"></i>Add</button>
            </div>

            <!-- Bind 'Id', 'ImgeUrl', 'CreatedOn' in hidden field-->
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="ImageUrl" />
            <input type="hidden" asp-for="CreatedOn" />
            <!-- -->
            <button type="submit" class="btn btn-primary">Save</button>
            <a class="btn btn-secondary" href="javascript: history.go(-1)">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function readImage(input) {
            if (input.files && input.files[0]) {
                $('#fileName').html(input.files[0].name);
                var reader = new FileReader();

                reader.onload = function (e) {
                    $('#thumbnail').attr('src', e.target.result);
                }
                reader.readAsDataURL(input.files[0]); // convert to base64 string
            }
        }

        /** Event handler for delete button of custom fields */
        function attachDeleteEventHandlers() {
            $("#customFields button[name='removeField']").on("click", function () {
                let index = $(this).closest("div[data-index]").data("index");

                $("#customFields").children("div").eq(index + 1).remove();

                const total = $("#customFields").children("div").length - 1;

                for (let i = index; i < total; i++) {
                    let el = $("#customFields").children("div").eq(i + 1);
                    $(el).data("index", i);

                    $(el).children("div").each(function (idx, outerDiv) {
                        if (idx == 0) {
                            $(outerDiv).find("input").attr("name", `ProductItemCustomFieldsViewModel[${i}].Key`);
                        }
                        else {
                            $(outerDiv).find("input").attr("name", `ProductItemCustomFieldsViewModel[${i}].Value`);
                        }
                    });
                }
            });
        }

        $(document).ready(function () {
            $("#imageFile").change(function () {
                readImage(this);
            });
            //Multiple select
            $(".selectpicker").selectpicker();
            //Datetime picker
            $("#releaseDate").datetimepicker({
                format: 'Y/m/d',
                formatDate: 'Y/m/d'
            });


            //Custom fields
            attachDeleteEventHandlers();
            $("#addField").click(function () {
                let nextIndex = $("#customFields").children("div").length - 1;
                let template = `<div class="form-group row" data-index=${nextIndex}>
                        <div class="col-5">
                            <input class="form-control" type="text" placeholder="Key" name="ProductItemCustomFieldsViewModel[${nextIndex}].Key" />
                        </div>
                        <div class="col-6">
                            <input class="form-control" type="text" placeholder="Value" name="ProductItemCustomFieldsViewModel[${nextIndex}].Value" />
                        </div>
                        <div class="col-1 d-flex justify-content-center">
                            <button type="button" name="removeField" class="btn btn-sm btn-light mt-1">
                                <i class="fas fa-trash text-danger"></i>
                            </button>
                        </div>
                    </div>`;

                $("#customFields").append(template);
                $("#customFields button[name='removeField']").off("click");
                attachDeleteEventHandlers();
            });
        });
    </script>
}