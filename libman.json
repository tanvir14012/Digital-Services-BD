{
  "version": "1.0",
  "defaultProvider": "cdnjs",
  "libraries": [
    {
      "library": "jquery@4.0.0",
      "destination": "wwwroot/lib/jquery/",
      "files": [
        "jquery.min.js"
      ]
    },
    {
      "library": "jquery-migrate@4.0.2",
      "destination": "wwwroot/lib/jquery-migrate/",
      "files": [
        "jquery-migrate.min.js"
      ]
    },
    {
      "library": "bootstrap@5.3.8",
      "destination": "wwwroot/lib/twitter-bootstrap/",
      "files": [
        "css/bootstrap.min.css",
        "js/bootstrap.bundle.min.js"
      ]
    },
    {
      "library": "jquery-validate@1.22.1",
      "destination": "wwwroot/lib/jquery-validate/",
      "files": [
        "jquery.validate.min.js"
      ]
    },
    {
      "library": "jquery-validation-unobtrusive@4.0.0",
      "destination": "wwwroot/lib/jquery-validation-unobtrusive/",
      "files": [
        "jquery.validate.unobtrusive.min.js"
      ]
    },
    {
      "library": "font-awesome@5.13.0",
      "destination": "wwwroot/lib/font-awesome/"
    },
    {
      "library": "bootstrap-select@1.14.0-beta3",
      "destination": "wwwroot/lib/bootstrap-select/"
    },
    {
      "library": "jquery-datetimepicker@2.5.20",
      "destination": "wwwroot/lib/jquery-datetimepicker/"
    },
    {
      "library": "jqueryui@1.14.2",
      "destination": "wwwroot/lib/jqueryui/"
    }
  ]
}
